@code {
	[Parameter]
	public int Width { get; set; } = 100;

	[Parameter]
	public int Height { get; set; } = 100;

	[Parameter]
	public string CssClass { get; set; } = "img-thumbnail";

	[Parameter]
	public string BackgroundColor { get; set; } = "#e9ecef";

	[Parameter]
	public string IconColor { get; set; } = "#6c757d";

	[Parameter]
	public string? Alt { get; set; } = "Image non disponible";

	private string SvgContent => GeneratePlaceholderSvg();

	private string GeneratePlaceholderSvg()
	{
		var iconSize = Math.Min(Width, Height) / 3;
		var centerX = Width / 2;
		var centerY = Height / 2;

		var svg = $"""
			<svg xmlns="http://www.w3.org/2000/svg" width="{Width}" height="{Height}" viewBox="0 0 {Width} {Height}">
				<rect width="100%" height="100%" fill="{BackgroundColor}"/>
				<g transform="translate({centerX - iconSize / 2}, {centerY - iconSize / 2})">
					<svg width="{iconSize}" height="{iconSize}" viewBox="0 0 16 16" fill="{IconColor}">
						<path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
						<path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
					</svg>
				</g>
			</svg>
			""";

		return $"data:image/svg+xml;base64,{Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg))}";
	}
}

<img src="@SvgContent" 
	 width="@Width" 
	 height="@Height" 
	 alt="@Alt" 
	 class="@CssClass" />
