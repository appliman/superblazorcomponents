@using System.Timers
@using Microsoft.Extensions.Logging
@inject ILogger<SuperDataGridStringFilter> Logger
@implements IDisposable

<div class="stcf-container">
    <input class="form-control stcf-input"
           type="text"
           placeholder="@Placeholder"
           value="@_value"
           @oninput="OnInputChanged" />

    @if (!string.IsNullOrWhiteSpace(_value))
    {
        <button type="button"
                class="stcf-clear"
                title="Effacer le filtre"
                @onclick="ClearAsync">
            ×
        </button>
    }
</div>

@code {
    [Parameter]
    public string PropertyName { get; set; } = string.Empty;    

    [Parameter]
    public EventCallback<SuperDataGridFilterInfo> ApplyFilter { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Filtre...";

    [Parameter]
    public int DelayMilliseconds { get; set; } = 2000;

    string _value = string.Empty;
    System.Timers.Timer _debouceTimer = new();
    SuperDataGridFilterInfo filterInfo = new();

    protected override void OnInitialized()
    {
        _debouceTimer.AutoReset = false;
        _debouceTimer.Elapsed += RaiseApplyFilter;
        _debouceTimer.Interval = DelayMilliseconds;

        filterInfo = new SuperDataGridFilterInfo
        {
            PropertyValue = _value,
            PropertyName = PropertyName,
            Operator = SuperDataGridFilterOperator.Contains,
            PropertyType = typeof(string)
        };

    }

    private async Task OnInputChanged(ChangeEventArgs args)
    {
        _value = args.Value?.ToString() ?? string.Empty;
        _debouceTimer.Stop();
        _debouceTimer.Start();
    }

    private void RaiseApplyFilter(object? s, ElapsedEventArgs e)
    {
        if (ApplyFilter.HasDelegate)
        {
            InvokeAsync(async () =>
            {
                try
                {
                    filterInfo.PropertyValue = _value;
                    await ApplyFilter.InvokeAsync(filterInfo);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, ex.Message);
                }
            });
            _debouceTimer.Stop();
        }
    }

    private async Task ClearAsync()
    {
        _debouceTimer.Stop();
        _value = string.Empty;

        if (ApplyFilter.HasDelegate)
        {
            filterInfo.PropertyValue = null;
            await ApplyFilter.InvokeAsync(filterInfo);
        }
        _debouceTimer.Stop();
    }

    public void Dispose()
    {
        _debouceTimer.Elapsed -= RaiseApplyFilter;
        _debouceTimer.Dispose();
    }
}
