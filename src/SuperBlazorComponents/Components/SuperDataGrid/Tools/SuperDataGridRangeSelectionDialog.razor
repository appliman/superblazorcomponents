@using Microsoft.AspNetCore.Components.Forms
@typeparam TItem
@implements IDisposable
@inject SuperDialogService DialogService
@inject IStringLocalizer Loc

<div class="container-fluid py-2">
    <p>@string.Format(Loc["DataGrid.Selection.Range.Total"], SuperDataGrid.TotalRowCount)</p>
    <p class="text-body-secondary">@Loc["DataGrid.Selection.Range.Help"]</p>
    <fieldset disabled="@_busy">
        <label for="@(_fieldId + "-mode")" class="form-label">@Loc["DataGrid.Selection.Range.Mode"]</label>
        <InputSelect id="@(_fieldId + "-mode")" class="form-select mb-3" @bind-Value="_firstRows">
            <option value="true">@Loc["DataGrid.Selection.Range.First"]</option>
            <option value="false">@Loc["DataGrid.Selection.Range.Between"]</option>
        </InputSelect>
        @if (!_firstRows)
        {
            <label for="@(_fieldId + "-from")" class="form-label">@Loc["DataGrid.Selection.Range.From"]</label>
            <input id="@(_fieldId + "-from")" class="form-control mb-3" type="number" value="@_from" @oninput="@(e => _from = ParseRow(e))" min="1" max="@SuperDataGrid.TotalRowCount" step="1" required />
        }
        <label for="@(_fieldId + "-to")" class="form-label">@Loc[_firstRows ? "DataGrid.Selection.Range.Count" : "DataGrid.Selection.Range.To"]</label>
        <input id="@(_fieldId + "-to")" class="form-control" type="number" value="@_to" @oninput="@(e => _to = ParseRow(e))" min="1" max="@SuperDataGrid.TotalRowCount" step="1" required />
    </fieldset>
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger mt-3" role="alert">@_error</div>
    }
    @if (_busy)
    {
        <p class="mt-3" role="status"><span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@Loc["DataGrid.Selection.Range.Loading"]</p>
    }
</div>
<div class="d-flex justify-content-end gap-2 border-top mt-4 pt-3">
    <button type="button" class="btn btn-outline-secondary" @onclick="CancelAsync">@Loc["DataGrid.Selection.Range.Cancel"]</button>
    <button type="button" class="btn btn-primary" disabled="@(_busy || !CanApply)" @onclick="ApplyAsync">@Loc["DataGrid.Selection.Range.Apply"]</button>
</div>

@code {
    [Parameter, EditorRequired]
    public SuperDataGrid<TItem> SuperDataGrid { get; set; } = default!;

    private readonly string _fieldId = "sdg-range-" + Guid.NewGuid().ToString("N");
    private readonly CancellationTokenSource _cancellation = new();
    private bool _firstRows = true;
    private int? _from;
    private int? _to;
    private bool _busy;
    private bool _disposed;
    private string? _error;
    private int FromRow => _firstRows ? 1 : _from ?? 0;
    private bool CanApply => FromRow >= 1 && _to >= FromRow && _to <= SuperDataGrid.TotalRowCount;

    private static int? ParseRow(ChangeEventArgs args)
    {
        return int.TryParse(args.Value?.ToString(), out var row) ? row : null;
    }

    private async Task ApplyAsync()
    {
        if (_busy || !CanApply)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            await SuperDataGrid.SelectRangeAsync(FromRow, _to!.Value, _cancellation.Token);
            if (!_disposed)
            {
                await DialogService.Close(true);
            }
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // Closing the dialog cancels loading without changing the old selection.
        }
        catch (Exception)
        {
            _error = Loc["DataGrid.Selection.Range.Error"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync()
    {
        _cancellation.Cancel();
        await DialogService.Close();
    }

    public void Dispose()
    {
        _disposed = true;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
