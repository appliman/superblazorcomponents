@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDataGrid
@using SuperBlazorComponents.Components.SuperSplitter
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json

@typeparam TItem
@implements IAsyncDisposable
@inject IStringLocalizer Loc
@inject SuperDialogService DialogService
@inject IJSRuntime JSRuntime

@if (_effectiveSuperDataGrid is not null)
{
    <div @ref="_tool" class="dropdown super-datagrid-columns-tool">
        <button @ref="_toggle" class="btn btn-secondary btn-sm dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                data-bs-auto-close="outside"
                aria-expanded="false"
                title="@Loc["DataGrid.Columns.Visible"]">
            <i class="fa-solid fa-eye"></i>
            <span class="ms-1">@Loc["DataGrid.Columns.Label"]</span>
        </button>

        <ul class="dropdown-menu super-datagrid-columns-menu">
            @if (_effectiveSuperDataGrid.SupportsColumnProfiles)
            {
                <li class="super-datagrid-profiles px-2 py-1">
                    <label for="@_profilesId" class="form-label fw-semibold">@Loc["DataGrid.Profiles.Label"]</label>
                    <select id="@_profilesId" class="form-select form-select-sm" value="@_effectiveSuperDataGrid.ActiveColumnProfileId"
                            disabled="@_busy" @onchange="SelectProfile">
                        <option value="">@Loc["DataGrid.Profiles.Current"]</option>
                        @foreach (var profile in _effectiveSuperDataGrid.ColumnProfiles)
                        {
                            <option value="@profile.Id" @key="profile.Id">@profile.Name</option>
                        }
                    </select>
                    @if (_effectiveSuperDataGrid.ActiveColumnProfileId is not null)
                    {
                        <small class="text-body-secondary d-block mt-1">@Loc["DataGrid.Profiles.AutoSave"]</small>
                    }
                </li>
                <li><button type="button" class="dropdown-item" disabled="@_busy" @onclick="SaveAs"><i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>@Loc["DataGrid.Profiles.SaveAs"]</button></li>
                <li><button type="button" class="dropdown-item" disabled="@(_busy || _effectiveSuperDataGrid.ActiveColumnProfileId is null)" @onclick="Rename"><i class="fa-solid fa-pen me-2" aria-hidden="true"></i>@Loc["DataGrid.Profiles.Rename"]</button></li>
                <li><button type="button" class="dropdown-item" disabled="@(_busy || _effectiveSuperDataGrid.ActiveColumnProfileId is null)" @onclick="Delete"><i class="fa-solid fa-trash-can me-2" aria-hidden="true"></i>@Loc["DataGrid.Profiles.Delete"]</button></li>
                <li><hr class="dropdown-divider" /></li>
                <li><button type="button" class="dropdown-item" disabled="@_busy" @onclick="Export"><i class="fa-solid fa-arrow-up-from-bracket me-2" aria-hidden="true"></i>@Loc["DataGrid.Profiles.Export"]</button></li>
                <li class="super-datagrid-profile-import">
                    <label for="@(_profilesId + "-file")" class="dropdown-item"><i class="fa-solid fa-file-import me-2" aria-hidden="true"></i>@Loc["DataGrid.Profiles.Import"]</label>
                    <InputFile id="@(_profilesId + "-file")" class="visually-hidden" accept=".json,application/json" disabled="@_busy" OnChange="Import" />
                </li>
                <li><hr class="dropdown-divider" /></li>
            }
            @if (_error is not null || _effectiveSuperDataGrid.ColumnProfilesStorageFailed)
            {
                <li><div class="alert alert-danger mx-2 my-1" role="alert">@(_error ?? Loc["DataGrid.Profiles.StorageError"].Value)</div></li>
            }
            <li class="dropdown-header super-datagrid-columns-title">
                <i class="fa-solid fa-eye me-2" aria-hidden="true"></i>
                @Loc["DataGrid.Columns.Visible"]
            </li>
            @if (_effectiveSuperDataGrid.AllowColumnReorder || _effectiveSuperDataGrid.AllowColumnResize)
            {
                <li>
                    <button type="button" class="dropdown-item" title="@Loc["DataGrid.Reset.Tooltip"]"
                            disabled="@_busy" @onclick="Reset">
                        <i class="fa-solid fa-rotate-left me-2" aria-hidden="true"></i>
                        @Loc["DataGrid.Columns.Reset"]
                    </button>
                </li>
                <li><hr class="dropdown-divider" /></li>
            }
            @foreach (var column in _columns)
            {
                <li class="super-datagrid-column-row" @key="_effectiveSuperDataGrid.ColumnsCollection[column.ColumnIndex]">
                    <label class="dropdown-item super-datagrid-column-item">
                        <input type="checkbox"
                               class="form-check-input"
                               checked="@column.IsVisible"
                               disabled="@(_busy || column.IsAlwaysVisible)"
                               @onchange="@(args => OnColumnVisibilityChangedAsync(column, args))" />
                        <span>@column.DisplayName</span>
                    </label>
                    @if (_effectiveSuperDataGrid.AllowColumnReorder)
                    {
                        <div class="super-datagrid-column-move">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    title="@Loc["DataGrid.Columns.MoveUp", column.DisplayName]"
                                    aria-label="@Loc["DataGrid.Columns.MoveUp", column.DisplayName]"
                                    disabled="@(_busy || !_effectiveSuperDataGrid.CanMoveColumn(column.ColumnIndex, -1))"
                                    @onclick="@(() => Run(() => _effectiveSuperDataGrid.MoveColumnAsync(column.ColumnIndex, -1)))">
                                <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    title="@Loc["DataGrid.Columns.MoveDown", column.DisplayName]"
                                    aria-label="@Loc["DataGrid.Columns.MoveDown", column.DisplayName]"
                                    disabled="@(_busy || !_effectiveSuperDataGrid.CanMoveColumn(column.ColumnIndex, 1))"
                                    @onclick="@(() => Run(() => _effectiveSuperDataGrid.MoveColumnAsync(column.ColumnIndex, 1)))">
                                <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    </div>
}

@code {
    private SuperDataGrid<TItem>? _effectiveSuperDataGrid;
    private List<SuperDataGridColumnVisibilityInfo> _columns = [];
    private readonly string _profilesId = "sdg-profiles-" + Guid.NewGuid().ToString("N");
    private ElementReference _toggle;
    private ElementReference _tool;
    private IJSObjectReference? _module;
    private bool _busy;
    private string? _error;

    private Task SelectProfile(ChangeEventArgs args) => Run(() => _effectiveSuperDataGrid!.SelectColumnProfileAsync(string.IsNullOrEmpty(args.Value?.ToString()) ? null : args.Value.ToString()));
    private Task Reset() => Run(() => _effectiveSuperDataGrid!.ResetColumnSettingsAsync());
    private Task SaveAs() => Run(() => OpenNameDialog(Loc["DataGrid.Profiles.SaveAs"], string.Empty, _effectiveSuperDataGrid!.SaveColumnProfileAsync));

    private Task Rename() => Run(async () =>
    {
        var grid = _effectiveSuperDataGrid!;
        var profile = grid.ColumnProfiles.First(p => p.Id == grid.ActiveColumnProfileId);
        await OpenNameDialog(Loc["DataGrid.Profiles.Rename"], profile.Name, name => grid.RenameColumnProfileAsync(profile.Id, name));
    });

    private Task Delete() => Run(async () =>
    {
        var grid = _effectiveSuperDataGrid!;
        var id = grid.ActiveColumnProfileId!;
        if (await DialogService.Confirm(Loc["DataGrid.Profiles.Delete"], Loc["DataGrid.Profiles.DeleteConfirm"]))
        {
            await grid.DeleteColumnProfileAsync(id);
        }
        await _toggle.FocusAsync();
    });

    private async Task OpenNameDialog(string title, string name, Func<string, Task> save)
    {
        await DialogService.OpenAsync<SuperDataGridColumnProfileDialog>(title, new Dictionary<string, object>
        {
            [nameof(SuperDataGridColumnProfileDialog.InitialName)] = name,
            [nameof(SuperDataGridColumnProfileDialog.Save)] = save
        });
        await _toggle.FocusAsync();
    }

    private Task Export() => Run(async () =>
    {
        await _module!.InvokeVoidAsync("downloadConfiguration", _effectiveSuperDataGrid!.ExportColumnProfileJson());
    });

    private Task Import(InputFileChangeEventArgs args) => Run(async () =>
    {
        if (!args.File.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        {
            throw new JsonException();
        }
        await using var stream = args.File.OpenReadStream(1_048_576);
        using var reader = new System.IO.StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        SuperDataGridColumnProfileDocument document;
        try
        {
            document = SuperDataGridColumnProfileDocument.FromJson(json);
        }
        catch (ArgumentException)
        {
            throw new JsonException();
        }
        if (!document.Columns.Any(s => _effectiveSuperDataGrid!.ColumnsCollection.Any(c => c.Property == s.PropertyName)))
        {
            throw new JsonException();
        }
        await OpenNameDialog(Loc["DataGrid.Profiles.Import"], document.Name, name => _effectiveSuperDataGrid!.ImportColumnProfileAsync(json, name));
    });

    private async Task Run(Func<Task> action)
    {
        if (_busy)
        {
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            await action();
        }
        catch (Exception exception) when (exception is JsonException or System.IO.IOException or ArgumentException)
        {
            _error = Loc["DataGrid.Profiles.ImportError"];
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            _error = Loc["DataGrid.Profiles.StorageError"];
        }
        finally
        {
            _busy = false;
        }
    }

    [Parameter]
    public SuperDataGrid<TItem>? SuperDataGrid { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<SuperDataGridColumnVisibilityInfo>> ColumnVisibilityChanged { get; set; }

    [Parameter]
    public SuperButtonSize Size { get; set; } = SuperButtonSize.Default;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SuperDataGrid<TItem>.GridInstanceReady += OnGridInstanceReady;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_effectiveSuperDataGrid is not null && _module is null)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/SuperBlazorComponents/Components/SuperDataGrid/Tools/SuperDatagridColumnVisibilityButton.razor.js");
            await _module.InvokeVoidAsync("initialize", _tool);
        }
    }

    protected override void OnParametersSet()
    {
        var requestedGrid = SuperDataGrid ?? _effectiveSuperDataGrid;
        SetEffectiveSuperDataGrid(requestedGrid);
        RefreshColumns();
        base.OnParametersSet();
    }

    private void OnGridInstanceReady(SuperDataGrid<TItem> grid)
    {
        if (_effectiveSuperDataGrid is not null)
        {
            return;
        }

        SetEffectiveSuperDataGrid(grid);
        SuperDataGrid = grid;
        RefreshColumns();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnColumnVisibilityChangedAsync(SuperDataGridColumnVisibilityInfo column, ChangeEventArgs args)
    {
        if (_effectiveSuperDataGrid is null)
        {
            return;
        }

        if (column.IsAlwaysVisible)
        {
            return;
        }

        if (args.Value is not bool isVisible)
        {
            return;
        }

        await Run(() => _effectiveSuperDataGrid.SetColumnVisibilityAsync(column.ColumnIndex, isVisible));
        RefreshColumns();

        if (ColumnVisibilityChanged.HasDelegate)
        {
            await ColumnVisibilityChanged.InvokeAsync(_columns);
        }
    }

    private void RefreshColumns()
    {
        if (_effectiveSuperDataGrid is null)
        {
            _columns = [];
            return;
        }

        _columns = _effectiveSuperDataGrid.GetColumnVisibilityInfo().ToList();
    }

    private void SetEffectiveSuperDataGrid(SuperDataGrid<TItem>? grid)
    {
        if (ReferenceEquals(_effectiveSuperDataGrid, grid))
        {
            return;
        }

        if (_effectiveSuperDataGrid is not null)
        {
            _effectiveSuperDataGrid.ColumnStateChanged -= OnColumnStateChanged;
        }

        _effectiveSuperDataGrid = grid;

        if (_effectiveSuperDataGrid is not null)
        {
            _effectiveSuperDataGrid.ColumnStateChanged += OnColumnStateChanged;
        }
    }

    private void OnColumnStateChanged(object? sender, EventArgs args)
    {
        RefreshColumns();
        _ = InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        SuperDataGrid<TItem>.GridInstanceReady -= OnGridInstanceReady;
        if (_effectiveSuperDataGrid is not null)
        {
            _effectiveSuperDataGrid.ColumnStateChanged -= OnColumnStateChanged;
        }
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _tool);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already released this tool with the disconnected circuit.
            }
        }
    }
}
