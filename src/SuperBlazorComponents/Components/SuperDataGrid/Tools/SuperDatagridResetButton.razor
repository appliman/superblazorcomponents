@using SuperBlazorComponents.Components.Buttons
@using Microsoft.AspNetCore.Components.Web
@typeparam TItem
@implements IDisposable

@if (_effectiveSuperDataGrid is not null)
{
    <SuperButton Icon="fa-rotate-left"
                 Style="SuperButtonStyle.Secondary"
                 Size="@Size"
                 title="Réinitialiser la configuration de la grille et supprimer les préférences enregistrées"
                 Click="OnResetAsync" />
}

@code {
    private SuperDataGrid<TItem>? _effectiveSuperDataGrid;

    [Parameter]
    public SuperDataGrid<TItem>? SuperDataGrid { get; set; }

    [Parameter]
    public EventCallback Reset { get; set; }

    [Parameter]
    public SuperButtonSize Size { get; set; } = SuperButtonSize.Default;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        SuperDataGrid<TItem>.GridInstanceReady += OnGridInstanceReady;
    }

    protected override void OnParametersSet()
    {
        _effectiveSuperDataGrid = SuperDataGrid ?? _effectiveSuperDataGrid;
        base.OnParametersSet();
    }

    private void OnGridInstanceReady(SuperDataGrid<TItem> grid)
    {
        if (_effectiveSuperDataGrid is not null)
        {
            return;
        }

        _effectiveSuperDataGrid = grid;
        SuperDataGrid = grid;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnResetAsync(MouseEventArgs args)
    {
        if (_effectiveSuperDataGrid is null)
        {
            return;
        }

        await _effectiveSuperDataGrid.ResetColumnSettingsAsync();

        if (Reset.HasDelegate)
        {
            await Reset.InvokeAsync();
        }
    }

    public void Dispose()
    {
        SuperDataGrid<TItem>.GridInstanceReady -= OnGridInstanceReady;
    }
}
