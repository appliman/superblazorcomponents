@namespace SuperBlazorComponents.Components.SuperHtmlEditor
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="she-wrapper @(_disabled ? "she-disabled" : "")">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label she-label">@Label</label>
    }

    <div class="she-editor-box @(_isFocused ? "she-focused" : "") @(_isHtmlMode ? "she-html-mode" : "")">

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <div class="she-toolbar" @ref="_toolbarRef">

            <!-- Font family -->
            <select class="she-select she-font-family" title="Police" disabled="@(_disabled || _isHtmlMode)"
                    @onchange="OnFontFamilyChange">
                <option value="">Fonte</option>
                <option value="Arial">Arial</option>
                <option value="Georgia">Georgia</option>
                <option value="Courier New">Courier New</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Verdana">Verdana</option>
                <option value="Trebuchet MS">Trebuchet MS</option>
            </select>

            <!-- Font size -->
            <select class="she-select she-font-size" title="Taille" disabled="@(_disabled || _isHtmlMode)"
                    @onchange="OnFontSizeChange">
                <option value="">Taille</option>
                <option value="1">8</option>
                <option value="2">10</option>
                <option value="3">12</option>
                <option value="4">14</option>
                <option value="5">18</option>
                <option value="6">24</option>
                <option value="7">36</option>
            </select>

            <span class="she-sep"></span>

            <!-- Bold -->
            <button type="button" class="she-btn @(_boldActive ? "she-active" : "")" title="Gras (Ctrl+B)"
                    disabled="@(_disabled || _isHtmlMode)" @onclick="ToggleBold">
                <b>B</b>
            </button>

            <!-- Italic -->
            <button type="button" class="she-btn @(_italicActive ? "she-active" : "")" title="Italique (Ctrl+I)"
                    disabled="@(_disabled || _isHtmlMode)" @onclick="ToggleItalic">
                <i>I</i>
            </button>

            <!-- Underline -->
            <button type="button" class="she-btn @(_underlineActive ? "she-active" : "")" title="Souligné (Ctrl+U)"
                    disabled="@(_disabled || _isHtmlMode)" @onclick="ToggleUnderline">
                <u>S</u>
            </button>

            <span class="she-sep"></span>

            <!-- Text color -->
            <label class="she-btn she-color-btn" title="Couleur du texte"
                   style="@(_disabled || _isHtmlMode ? "pointer-events:none;opacity:.5;" : "")">
                <span class="she-color-icon">
                    <span class="she-color-a">A</span>
                    <span class="she-color-bar" style="background:@_textColor"></span>
                </span>
                <input type="color" class="she-hidden-color" value="@_textColor" disabled="@(_disabled || _isHtmlMode)"
                       @onchange="OnTextColorChange" />
            </label>

            <!-- Background / highlight color -->
            <label class="she-btn she-color-btn" title="Couleur de fond du texte"
                   style="@(_disabled || _isHtmlMode ? "pointer-events:none;opacity:.5;" : "")">
                <span class="she-color-icon">
                    <span class="she-color-a" style="background:@_bgColor;padding:0 2px;">A</span>
                    <span class="she-color-bar" style="background:@_bgColor"></span>
                </span>
                <input type="color" class="she-hidden-color" value="@_bgColor" disabled="@(_disabled || _isHtmlMode)"
                       @onchange="OnBgColorChange" />
            </label>

            <span class="she-sep"></span>

            <!-- Align left -->
            <button type="button" class="she-btn" title="Aligner à gauche" disabled="@(_disabled || _isHtmlMode)"
                    @onclick='() => ExecCommand("justifyLeft", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M2 4h12v1.5H2zm0 3h8v1.5H2zm0 3h12v1.5H2zm0 3h8v1.5H2z" />
                </svg>
            </button>

            <!-- Align center -->
            <button type="button" class="she-btn" title="Centrer" disabled="@(_disabled || _isHtmlMode)"
                    @onclick='() => ExecCommand("justifyCenter", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M2 4h12v1.5H2zm2 3h8v1.5H4zm-2 3h12v1.5H2zm2 3h8v1.5H4z" />
                </svg>
            </button>

            <!-- Align right -->
            <button type="button" class="she-btn" title="Aligner à droite" disabled="@(_disabled || _isHtmlMode)"
                    @onclick='() => ExecCommand("justifyRight", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M2 4h12v1.5H2zm4 3h8v1.5H6zm-4 3h12v1.5H2zm4 3h8v1.5H6z" />
                </svg>
            </button>

            <span class="she-sep"></span>

            <!-- Ordered list -->
            <button type="button" class="she-btn" title="Liste numérotée" disabled="@(_disabled || _isHtmlMode)"
                    @onclick='() => ExecCommand("insertOrderedList", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path
                    d="M5 4h9v1.5H5zm0 4h9v1.5H5zm0 4h9v1.5H5zM1.5 3h1v3h-1V4.5H1V3.5h.5zm-.3 8.5h1.8v.5H2.1l1 1.3-.8.6-1.4-1.9v-.5h.3zm.3-4.5V8h1.5v.5h-1v.5h1V10h-1.5v-.5h1v-.5H1.5z" />
                </svg>
            </button>

            <!-- Unordered list -->
            <button type="button" class="she-btn" title="Liste à puces" disabled="@(_disabled || _isHtmlMode)"
                    @onclick='() => ExecCommand("insertUnorderedList", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path
                    d="M5 4h9v1.5H5zm0 4h9v1.5H5zm0 4h9v1.5H5zM2 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm0 4a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm0 4a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                </svg>
            </button>

            <span class="she-sep"></span>

            <!-- Remove formatting -->
            <button type="button" class="she-btn" title="Supprimer la mise en forme"
                    disabled="@(_disabled || _isHtmlMode)" @onclick='() => ExecCommand("removeFormat", null)'>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M6.5 1h4l-.5 2H9L8.5 5h1l-.5 2h-1L7.5 9h1l-.5 2h-3l.5-2h1l.5-2h-1l.5-2h1l.5-2H7z" />
                    <line x1="1" y1="14" x2="15" y2="14" stroke="currentColor" stroke-width="1.5" />
                    <line x1="1" y1="1" x2="15" y2="15" stroke="red" stroke-width="1.5" />
                </svg>
            </button>

            <span class="she-spacer"></span>

            <!-- Toggle HTML source -->
            <button type="button" class="she-btn she-btn-code @(_isHtmlMode ? "she-active" : "")"
                    title="@(_isHtmlMode ? "Retour éditeur visuel" : "Éditer le HTML source")" disabled="@_disabled"
                    @onclick="ToggleHtmlMode">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
                    <path
                    d="M5.3 11.7 1 8l4.3-3.7.9 1.1L2.8 8l3.4 2.6zM10.7 11.7l-.9-1.1L13.2 8 9.8 5.4l.9-1.1L15 8zM7 13l1.5-10h1.1L8.1 13z" />
                </svg>
                <span class="ms-1">HTML</span>
            </button>
        </div>

        <!-- ── WYSIWYG editable area ─────────────────────────────────────── -->
        <div class="she-content @(_isHtmlMode ? "she-hidden" : "")" @ref="_editorRef"
             style="min-height:@(MinHeight)px; max-height:@(MaxHeight > 0 ? MaxHeight + "px" : "none")">
        </div>

        <!-- ── Monaco HTML source editor ────────────────────────────────── -->
        <div class="she-monaco-container @(_isHtmlMode ? "" : "she-hidden")" @ref="_monacoRef"
             style="height:@(MonacoHeight)px">
            @if (_monacoLoading)
            {
                <div class="she-monaco-loading">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Chargement de l'éditeur de code…
                </div>
            }
        </div>

    </div>
</div>
