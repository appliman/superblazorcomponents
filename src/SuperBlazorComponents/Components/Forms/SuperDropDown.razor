@typeparam TItem
@typeparam TValue

@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms

@inject IStringLocalizer Loc

@code {
    [CascadingParameter]
    public EditContext? CurrentEditContext { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter]
    public IEnumerable<TItem>? Data { get; set; }

    [Parameter]
    public string TextProperty { get; set; } = "Name";

    [Parameter]
    public string ValueProperty { get; set; } = "Id";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public string? HelpText { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? PlaceHolder { get; set; }

    [Parameter]
    public System.Linq.Expressions.Expression<Func<TValue?>>? ValueExpression { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? CapturedAttributes { get; set; }

    string labelColumnClass = "col-sm-12 col-md-2";
    string inputColumnClass = "col-sm-12 col-md-10";
    string css = "form-select";

    PropertyInfo? _textPropertyInfo;
    PropertyInfo? _valuePropertyInfo;
    string? _resolvedTextProperty;
    string? _resolvedValueProperty;

    protected override void OnInitialized()
    {
        if (CapturedAttributes?.ContainsKey("class") == true)
        {
            var value = (string)CapturedAttributes["class"];
            css = $"{css} {value}";
            CapturedAttributes.Remove("class");
        }
    }

    protected override void OnParametersSet()
    {
        labelColumnClass = string.IsNullOrWhiteSpace(Label) ? "" : "col-sm-12 col-md-2";
        inputColumnClass = string.IsNullOrWhiteSpace(Label) ? "col-md-12" : "col-sm-12 col-md-10";

        if (_resolvedTextProperty != TextProperty || _resolvedValueProperty != ValueProperty)
        {
            var itemType = typeof(TItem);

            var textProp = itemType.GetProperty(TextProperty);
            if (textProp is null)
            {
                throw new InvalidOperationException(Loc["DropDown.PropertyNotFound", TextProperty, itemType.Name]);
            }

            var valueProp = itemType.GetProperty(ValueProperty);
            if (valueProp is null)
            {
                throw new InvalidOperationException(Loc["DropDown.PropertyNotFound", ValueProperty, itemType.Name]);
            }

            _textPropertyInfo = textProp;
            _valuePropertyInfo = valueProp;
            _resolvedTextProperty = TextProperty;
            _resolvedValueProperty = ValueProperty;
        }
    }

    async Task OnValueChanged(ChangeEventArgs args)
    {
        var selectedValue = args.Value?.ToString();

        if (string.IsNullOrEmpty(selectedValue))
        {
            Value = default;
        }
        else
        {
            try
            {
                Value = (TValue)Convert.ChangeType(selectedValue, typeof(TValue));
            }
            catch
            {
                Value = default;
            }
        }

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }

    string? GetTextValue(TItem item)
    {
        if (item is null || _textPropertyInfo is null)
            return null;

        return _textPropertyInfo.GetValue(item)?.ToString();
    }

    string? GetValueAsString(TItem item)
    {
        if (item is null || _valuePropertyInfo is null)
            return null;

        return _valuePropertyInfo.GetValue(item)?.ToString();
    }

    bool IsSelected(TItem item)
    {
        if (item is null || Value is null)
            return false;

        var itemValue = GetValueAsString(item);
        return Value.ToString() == itemValue;
    }
}

<div class="form-group row mb-3 align-items-center">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <div class="@labelColumnClass">
            <label class="form-label">
                @Label
                @if (Required)
                {
                    <span class="text-primary fs-4" title="@Loc["DropDown.RequiredField"]">*</span>
                }
            </label>
        </div>
    }
    <div class="@inputColumnClass">
        <select class="@css" 
                value="@Value" 
                disabled="@Disabled" 
                @onchange="OnValueChanged"
                @attributes="CapturedAttributes">
            @if (!string.IsNullOrWhiteSpace(PlaceHolder))
            {
                <option value="">@PlaceHolder</option>
            }
            else if (!Required)
            {
                <option value="">@Loc["DropDown.EmptyOption"]</option>
            }
            @if (Data is not null)
            {
                foreach (var item in Data)
                {
                    <option value="@GetValueAsString(item)" selected="@IsSelected(item)">
                        @GetTextValue(item)
                    </option>
                }
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(HelpText))
        {
            <small class="form-text text-muted">@HelpText</small>
        }
        @if (ValueExpression is not null)
        {
            <ValidationMessage For="ValueExpression" />
        }
    </div>
</div>
