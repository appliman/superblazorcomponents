@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

@code {
    [CascadingParameter]
    public EditContext? CurrentEditContext { get; set; }

    /// <summary>
    /// Label displayed next to the switch.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Current value of the switch.
    /// </summary>
    [Parameter]
    public bool Value { get; set; }

    /// <summary>
    /// Event raised when the switch value changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// Expression used for Blazor form validation.
    /// </summary>
    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    /// <summary>
    /// Disables the switch when true.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Optional help text displayed below the switch.
    /// </summary>
    [Parameter]
    public string? HelpText { get; set; }

    /// <summary>
    /// Position of the label relative to the switch. Defaults to <see cref="SuperSwitchLabelPosition.Right"/>.
    /// </summary>
    [Parameter]
    public SuperSwitchLabelPosition LabelPosition { get; set; } = SuperSwitchLabelPosition.Right;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? CapturedAttributes { get; set; }

    private readonly string _id = $"super-switch-{Guid.NewGuid():N}";

    private string WrapperClass =>
        LabelPosition == SuperSwitchLabelPosition.Left
            ? "form-check form-switch form-check-reverse"
            : "form-check form-switch";

    private async Task OnValueChanged(ChangeEventArgs e)
    {
        var newValue = e.Value is bool b ? b : false;
        Value = newValue;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(newValue);
        }
    }
}

<div class="@WrapperClass">
    <input class="form-check-input"
           type="checkbox"
           role="switch"
           id="@_id"
           checked="@Value"
           disabled="@Disabled"
           @onchange="OnValueChanged"
           @attributes="CapturedAttributes" />
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-check-label" for="@_id">@Label</label>
    }
    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="form-text text-muted d-block">@HelpText</small>
    }
    @if (ValueExpression is not null && CurrentEditContext is not null)
    {
        <ValidationMessage For="ValueExpression" />
    }
</div>
