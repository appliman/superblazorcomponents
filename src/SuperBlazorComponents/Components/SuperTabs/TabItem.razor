@code {
    private bool _registered;
    private SuperTabItem? _lastTab;

    [CascadingParameter]
    internal SuperTabs? Owner { get; set; }

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? IconColor { get; set; }

    [Parameter]
    public string? BadgeText { get; set; }

    [Parameter]
    public string BadgeClass { get; set; } = "badge-primary";

    [Parameter]
    public string? BadgeIcon { get; set; }

    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool LazyLoad { get; set; }

    [Parameter]
    public bool Closable { get; set; }

    [Parameter]
    public int Order { get; set; } = int.MaxValue;

    [Parameter]
    public string? Tooltip { get; set; }

    [Parameter]
    public string? PersistenceKey { get; set; }

    [Parameter]
    public bool HasUnsavedChanges { get; set; }

    [Parameter]
    public string? ConfirmLeaveMessage { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? PolicyName { get; set; } 

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (Owner is null)
        {
            return Task.CompletedTask;
        }

        var tab = new SuperTabItem
        {
            Id = Id,
            Title = Title,
            Icon = Icon,
            IconColor = IconColor,
            BadgeText = BadgeText,
            BadgeClass = BadgeClass,
            BadgeIcon = BadgeIcon,
            Visible = Visible,
            Disabled = Disabled,
            LazyLoad = LazyLoad,
            Closable = Closable,
            Order = Order,
            Tooltip = Tooltip,
            PersistenceKey = PersistenceKey,
            HasUnsavedChanges = HasUnsavedChanges,
            ConfirmLeaveMessage = ConfirmLeaveMessage,
            Content = ChildContent,
            PolicyName = PolicyName
        };

        if (_registered && AreEquivalent(_lastTab, tab))
        {
            return Task.CompletedTask;
        }

        Owner.RegisterDeclarativeTab(tab);
        _registered = true;
        _lastTab = tab;
        return Task.CompletedTask;
    }

    private static bool AreEquivalent(SuperTabItem? a, SuperTabItem b)
    {
        if (a is null)
        {
            return false;
        }

        return a.Id == b.Id &&
               a.Title == b.Title &&
               a.Icon == b.Icon &&
               a.IconColor == b.IconColor &&
               a.BadgeText == b.BadgeText &&
               a.BadgeClass == b.BadgeClass &&
               a.BadgeIcon == b.BadgeIcon &&
               a.Visible == b.Visible &&
               a.Disabled == b.Disabled &&
               a.LazyLoad == b.LazyLoad &&
               a.Closable == b.Closable &&
               a.Order == b.Order &&
               a.Tooltip == b.Tooltip &&
               a.PersistenceKey == b.PersistenceKey &&
               a.HasUnsavedChanges == b.HasUnsavedChanges &&
               a.ConfirmLeaveMessage == b.ConfirmLeaveMessage;
    }
}