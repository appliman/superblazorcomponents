@namespace SuperBlazorComponents.Components.SuperLayout

<header class="super-header @StickyClass @CssClass">
    <nav class="navbar navbar-expand-lg super-header-nav @NavbarClass">
        <div class="super-header-container">
            <div class="super-header-brand">
                @if (ShowToggle)
                {
                    <button class="btn btn-link super-header-toggle p-0 border-0"
                            type="button"
                            @onclick="OnToggleClick"
                            aria-label="Toggle sidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                        </svg>
                    </button>
                }
                @if (Brand is not null)
                {
                    <div class="super-header-brand-content">
                        @Brand
                    </div>
                }
                else if (!string.IsNullOrEmpty(BrandText))
                {
                    <span class="navbar-brand super-header-brand-content mb-0">@BrandText</span>
                }
            </div>
            <div class="super-header-body collapse navbar-collapse @(NavbarExpanded ? "show" : "")" id="superHeaderNavbar">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
            </div>
            @if (EndContent is not null)
            {
                <div class="super-header-end d-flex align-items-center">
                    @EndContent
                </div>
            }
        </div>
    </nav>
</header>
