
@inject SuperDialogService DialogService
@inject IStringLocalizer Loc
@implements IDisposable

@if (_isVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@_title</h5>
                    <button type="button" class="btn-close" aria-label="@Loc["Dialog.Confirm.Close"]" @onclick="() => Close(false)"></button>
                </div>
                <div class="modal-body">
                    <p>@_message</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => Close(false)">
                        @_options.CancelButtonText
                    </button>
                    <button type="button" class="btn btn-primary" @onclick="() => Close(true)">
                        @_options.OkButtonText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private string _title = string.Empty;
    private string _message = string.Empty;
    private ConfirmOptions _options = new();

    protected override void OnInitialized()
    {
        DialogService.OnShow += Show;
    }

    private async Task Show(string title, string message, ConfirmOptions options)
    {
        _title = title;
        _message = message;
        _options = options;
        _isVisible = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task Close(bool result)
    {
        _isVisible = false;
        await InvokeAsync(StateHasChanged);
        DialogService.SetResult(result);
    }

    public void Dispose()
    {
        DialogService.OnShow -= Show;
    }
}
