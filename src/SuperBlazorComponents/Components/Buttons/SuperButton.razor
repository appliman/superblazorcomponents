@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

@inherits SuperButtonBase
@implements IAsyncDisposable

<button @ref="_buttonRef" class="@CssClass" @onclick="@OnClick" disabled="@IsDisabled" @attributes="@_additionalAttributes">
    @if (IsBusy)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span class="ms-2">@BusyText</span>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Image))
        {
            <img src="@Image" alt="@Text" title="@Text" class="super-button-image" aria-hidden="true" />
        }
        else if (!string.IsNullOrWhiteSpace(Icon))
        {
            <i class="@IconCssClass" title="@Text" aria-hidden="true"></i>
        }

        @if (!UseIconOnly)
        {
            @if (!string.IsNullOrWhiteSpace(Image) || !string.IsNullOrWhiteSpace(Icon))
            {
                <span class="ms-1"></span>
            }

            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Text
            }

            @if (!string.IsNullOrWhiteSpace(BadgeText))
            {
                <span class="ms-2">
                    <span class="@BadgeCssClass">@BadgeText</span>
                </span>
            }
        }
    }

</button>




