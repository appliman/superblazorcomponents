@namespace SuperBlazorComponents.Components.SuperColorPicker
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@WrapperClass">

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label scpdd-label" @onclick="Toggle">@Label</label>
    }

    <div class="scpdd-anchor">

        <!-- ── Trigger button ──────────────────────────────────────── -->
        <button type="button" class="scpdd-trigger" @ref="_triggerRef" @onclick="Toggle" @onkeydown="OnTriggerKeyDown" disabled="@Disabled"
                aria-haspopup="true" aria-expanded="@_isOpen.ToString().ToLowerInvariant()">
            <span class="scpdd-swatch">
                <span class="scpdd-checker"></span>
                <span class="scpdd-color" style="background-color:@DisplayColor"></span>
            </span>
            <span class="scpdd-caret">▾</span>
        </button>

        <!-- ── Dropdown popup ──────────────────────────────────────── -->
        @if (_isOpen)
        {
            <div class="scpdd-popup" @ref="_popupRef" style="@_popupStyle">
                <SuperColorPicker Value="@_value" ValueChanged="OnPickerChanged" ShowAlpha="ShowAlpha"
                                  Disabled="Disabled" ShowConfirmButton="true" />
            </div>
        }

    </div>

    <!-- ── Backdrop — click outside to close ──────────────────────── -->
    @if (_isOpen)
    {
        <div class="scpdd-backdrop" @onclick="Close"></div>
    }

</div>

@code {
    private string? _value;
    private string? _prevValue;
    private bool _isOpen;
    private bool _pendingPosition;
    private string _popupStyle = string.Empty;
    private ElementReference _triggerRef;
    private ElementReference _popupRef;
    private IJSObjectReference? _js;

    // ── Parameters ────────────────────────────────────────────────────

    /// <summary>Hex color value: #RRGGBB or #RRGGBBAA when ShowAlpha is true.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    /// <summary>Optional label displayed above the trigger button.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Show the alpha (opacity) slider inside the picker.</summary>
    [Parameter] public bool ShowAlpha { get; set; }

    /// <summary>Disables the trigger button and the picker.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Additional CSS class on the wrapper element.</summary>
    [Parameter] public string? CssClass { get; set; }

    [CascadingParameter] public EditContext? CurrentEditContext { get; set; }

    // ── Computed ──────────────────────────────────────────────────────

    private string WrapperClass => string.Join(" ", new[]
        { "scpdd-wrapper", _isOpen ? "scpdd-open" : null, Disabled ? "scpdd-disabled" : null, CssClass }
        .Where(s => !string.IsNullOrWhiteSpace(s)));

    /// <summary>
    /// Converts the stored value to a CSS color usable in background-color.
    /// Handles #RRGGBB and #RRGGBBAA formats.
    /// </summary>
    private string DisplayColor
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_value))
            {
                return "transparent";
            }

            var hex = _value.TrimStart('#');

            if (hex.Length == 8
                && uint.TryParse(hex[..6], NumberStyles.HexNumber, null, out var rgb)
                && int.TryParse(hex[6..], NumberStyles.HexNumber, null, out var aa))
            {
                var r = (rgb >> 16) & 0xFF;
                var g = (rgb >> 8) & 0xFF;
                var b = rgb & 0xFF;
                return $"rgba({r},{g},{b},{aa / 255.0:F2})";
            }

            return _value;
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────

    protected override void OnInitialized()
    {
        _value = Value;
        _prevValue = Value;
    }

    protected override void OnParametersSet()
    {
        if (Value != _prevValue)
        {
            _prevValue = Value;
            _value = Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isOpen && _pendingPosition)
        {
            _pendingPosition = false;
            _js ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/SuperBlazorComponents/Components/SuperColorPicker/SuperDropDownColorPicker.razor.js");

            _popupStyle = await _js.InvokeAsync<string>("positionPopup", _triggerRef, _popupRef);
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Interactions ──────────────────────────────────────────────────

    private void Toggle()
    {
        if (!Disabled)
        {
            _isOpen = !_isOpen;
            _pendingPosition = _isOpen;
            _popupStyle = _isOpen ? "visibility:hidden;" : string.Empty;
        }
    }

    private void Close()
    {
        _isOpen = false;
        _popupStyle = string.Empty;
    }

    private void OnTriggerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Tab")
        {
            _isOpen = false;
        }
        else if (e.Key is "Enter" or " " or "Spacebar")
        {
            Toggle();
        }
    }

    private async Task OnPickerChanged(string? newValue)
    {
        _value = newValue;
        _prevValue = newValue;

        await ValueChanged.InvokeAsync(newValue);

        if (ValueExpression is not null && CurrentEditContext is not null)
        {
            CurrentEditContext.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
        }

        Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_js is not null)
        {
            await _js.DisposeAsync();
        }
    }
}
