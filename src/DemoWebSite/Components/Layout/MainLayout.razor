@using Microsoft.AspNetCore.Components.Sections
@using SuperBlazorComponents.Components
@using SuperBlazorComponents.Components.Dialogs
@using SuperBlazorComponents.Components.Notifications
@using DemoWebSite.Components.Pages
@using SuperBlazorComponents.Components.SuperLayout
@using SuperBlazorComponents.Components.Themes

@inherits LayoutComponentBase
@implements IDisposable
@implements IAsyncDisposable

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<SuperLayout>
    <SuperHeader>
        <Brand>
            <b class="ms-1">SuperBlazorComponents</b>
        </Brand>
        <ChildContent>
            <div class="d-flex flex-row w-100 align-items-center">
                <div class="toolbar flex-grow-1">
                    @if (CurrentHelpFileName is not null)
                    {
                        <SuperDocumentationButton @key="CurrentHelpFileName" HelpFileName="@CurrentHelpFileName"
                                                  DisplayHtmlHelpText="OnDisplayHtmlHelpTextChanged" @ref="_displayHelpButton" />
                    }
                    <SectionOutlet SectionName="toolbar" />
                </div>
                <div class="config">
                    <SuperChatButton />
                    <ThemeToggle />
                    <a href="https://github.com/appliman/superblazorcomponents" target="_blank" title="GitHub">
                        <i class="fa-brands fa-github fa-lg"></i>
                    </a>
                </div>
            </div>
        </ChildContent>
    </SuperHeader>
    <SuperSidebar Theme="software">
        <ChildContent>
            <SuperMenuItem Href="/" Match="NavLinkMatch.All" Icon="fa-house" Text="Home" />
            <SuperMenuItem Href="superlayout" Match="NavLinkMatch.Prefix" Icon="fa-layer-group" Text="Layout"
                           BadgeText="Updated" BadgeCssClass="badge text-bg-info" />
            <SuperMenuItem Icon="fa-chart-line" Text="Charts">
                <Items>
                    <SuperMenuItem Href="google-charts-demo" Match="NavLinkMatch.Prefix" Icon="fa-chart-line"
                                   Text="Google Charts" />
                    <SuperMenuItem Href="google-pie-chart-demo" Match="NavLinkMatch.Prefix" Icon="fa-chart-pie"
                                   Text="Google Pie Chart" />
                </Items>
            </SuperMenuItem>
            <SuperMenuItem Href="super-date-range-picker-demo" Match="NavLinkMatch.Prefix" Icon="fa-calendar-days"
                           Text="Date Range Picker" />
            <SuperMenuItem Href="superbutton-demo" Match="NavLinkMatch.Prefix" Icon="fa-toggle-on"
                           Text="SuperButton Demo" />
            <SuperMenuItem Href="supertooltip-demo" Match="NavLinkMatch.Prefix" Icon="fa-comment-dots"
                           Text="SuperTooltip" BadgeText="New" BadgeCssClass="badge text-bg-success" />
            <SuperMenuItem Href="forms-demo" Match="NavLinkMatch.Prefix" Icon="fa-list-ul" Text="Forms" />
            <SuperMenuItem Href="super-color-picker-demo" Match="NavLinkMatch.Prefix" Icon="fa-palette"
                           Text="SuperColorPicker" />
            <SuperMenuItem Href="super-html-editor-demo" Match="NavLinkMatch.Prefix" Icon="fa-pen-to-square"
                           Text="SuperHtmlEditor" />
            <SuperMenuItem Href="super-markdown-editor-demo" Match="NavLinkMatch.Prefix" Icon="fa-markdown"
                           Text="SuperMarkdownEditor" />
            <SuperMenuItem Href="breadcrumb" Match="NavLinkMatch.Prefix" Icon="fa-ellipsis" Text="SuperBreadCrumb" />
            <SuperMenuItem Icon="fa-window-restore" Match="NavLinkMatch.Prefix" Text="Dialogs">
                <Items>
                    <SuperMenuItem Href="confirm-demo" Match="NavLinkMatch.Prefix" Icon="fa-circle-question"
                                   Text="Confirm" />
                    <SuperMenuItem Href="dialog-demo" Match="NavLinkMatch.Prefix" Icon="fa-window-maximize"
                                   Text="Dynamic dialog" />
                    <SuperMenuItem Href="super-date-range-dialog-demo" Match="NavLinkMatch.Prefix"
                                   Icon="fa-calendar-days" Text="Date range dialog" />
                </Items>
            </SuperMenuItem>
            <SuperMenuItem Href="notifications-demo" Match="NavLinkMatch.Prefix" Icon="fa-bell" Text="Notifications" />
            <SuperMenuItem Icon="fa-table-cells" Match="NavLinkMatch.Prefix" Text="SuperDataGrid">
                <Items>
                    <SuperMenuItem Href="supergrid-simple-demo" Match="NavLinkMatch.Prefix" Icon="fa-table"
                                   Text="SuperGrid Simple" />
                    <SuperMenuItem Href="supergrid-demo" Match="NavLinkMatch.Prefix" Icon="fa-table-cells"
                                   Text="SuperGrid Demo" />
                    <SuperMenuItem Href="supergrid-vertical-demo" Match="NavLinkMatch.Prefix"
                                   Icon="fa-grip-lines-vertical" Text="SuperGrid Vertical" />
                    <SuperMenuItem Href="supergrid-fixed-row-height-demo" Match="NavLinkMatch.Prefix"
                                   Icon="fa-align-justify" Text="Fixed row height" />
                    <SuperMenuItem Href="supergrid-dynamic-component-demo" Match="NavLinkMatch.Prefix"
                                   Icon="fa-puzzle-piece" Text="Dynamic component" />
                    <SuperMenuItem Href="todo-supergrid-demo" Match="NavLinkMatch.Prefix" Icon="fa-list-check"
                                   Text="Todo List (Edition)" />
                </Items>
            </SuperMenuItem>
            <SuperMenuItem Icon="fa-table-cells-large" Match="NavLinkMatch.Prefix" Text="SuperTabs">
                <Items>
                    <SuperMenuItem Href="super-tabs-demo/horizontal" Match="NavLinkMatch.Prefix" Icon="fa-grip-lines"
                                   Text="SuperTabs horizontal" />
                    <SuperMenuItem Href="super-tabs-demo/vertical" Match="NavLinkMatch.Prefix"
                                   Icon="fa-grip-lines-vertical" Text="SuperTabs vertical" />
                    <SuperMenuItem Href="super-tabs-demo/declaratif" Match="NavLinkMatch.Prefix" Icon="fa-code"
                                   Text="SuperTabs declarative" />
                </Items>
            </SuperMenuItem>
            <SuperMenuItem Icon="fa-object-group" Match="NavLinkMatch.Prefix" Text="SuperContext">
                <Items>
                    <SuperMenuItem Href="super-context-demo/bottom" Match="NavLinkMatch.Prefix" Icon="fa-down-long" Text="Bottom context" />
                    <SuperMenuItem Href="super-context-demo/right" Match="NavLinkMatch.Prefix" Icon="fa-right-long" Text="Right context" />
                    <SuperMenuItem Href="super-context-demo/both" Match="NavLinkMatch.Prefix" Icon="fa-table-columns" Text="Bottom + Right" />
                    <SuperMenuItem Href="super-context-demo/multiple" Match="NavLinkMatch.Prefix" Icon="fa-layer-group" Text="Multiple entities" />
                </Items>
            </SuperMenuItem>            <SuperMenuItem Icon="fa-grip" Match="NavLinkMatch.Prefix" Text="SuperSplitter">
                <Items>
                    <SuperMenuItem Href="splitter-demo/vertical" Match="NavLinkMatch.Prefix"
                                   Icon="fa-grip-lines-vertical" Text="Splitter vertical" />
                    <SuperMenuItem Href="splitter-demo/horizontal" Match="NavLinkMatch.Prefix" Icon="fa-grip-lines"
                                   Text="Splitter horizontal" />
                    <SuperMenuItem Href="splitter-demo/both" Match="NavLinkMatch.Prefix" Icon="fa-grip" Text="Both" />
                </Items>
            </SuperMenuItem>
        </ChildContent>
        <Footer>
            © @DateTimeOffset.Now.Year - <a href="https://www.appliman.com" target="_blank"
                                            class="text-decoration-none text-white">Appliman</a>
        </Footer>
    </SuperSidebar>
    <SuperChat Title="AI Chat">
        <p>Welcome to the AI assistant. Ask your questions here.</p>
    </SuperChat>
    <SuperBody>
        <div class="m-2" @ref="_bodyContentElement">
            @if (_displayHelp && _displayHelpButton is not null)
            {
                @(new MarkupString(_displayHelpButton.HtmlDocumentationText))
            }
            else
            {
                @Body
            }
        </div>
    </SuperBody>
</SuperLayout>

<SuperDialog />
<SuperConfirmDialog />
<SuperNotification Position="SuperBlazorComponents.Components.Notifications.NotificationPosition.TopRight" />

@code {
    private ElementReference _bodyContentElement;
    private IJSObjectReference? _documentationModule;
    private bool _displayHelp;
    private bool _renderMermaid;
    private SuperDocumentationButton? _displayHelpButton;

    private string? CurrentHelpFileName => GetHelpFileName(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private Task OnDisplayHtmlHelpTextChanged(bool displayHelp)
    {
        _displayHelp = displayHelp;
        _renderMermaid = displayHelp;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_displayHelp || !_renderMermaid)
        {
            return;
        }

        _renderMermaid = false;
        _documentationModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/documentation-mermaid.js?v=2");
        await _documentationModule.InvokeVoidAsync("renderMermaid", _bodyContentElement);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _displayHelp = false;
        _renderMermaid = false;
        StateHasChanged();
    }

    private static string? GetHelpFileName(string relativePath)
    {
        var route = relativePath.Split('?', '#')[0].Trim('/').ToLowerInvariant();

        return route switch
        {
            "superlayout" => "SUPERLAYOUT.md",
            "google-charts-demo" or "google-pie-chart-demo" => "GOOGLECHARTS.md",
            "super-date-range-picker-demo" => "SUPERDATERANGEPICKER.md",
            "superbutton-demo" => "SUPERBUTTONS.md",
            "supertooltip-demo" => "SUPERTOOLTIP.md",
            "forms-demo" => "SUPERTRISTATECHECKBOX.md",
            "super-color-picker-demo" => "SUPERCOLORPICKER.md",
            "super-html-editor-demo" => "SUPERHTMLEDITOR.md",
            "super-markdown-editor-demo" => "SUPERMARKDOWNEDITOR.md",
            "breadcrumb" => "SUPERBREADCRUMB.md",
            "confirm-demo" or "dialog-demo" or "super-date-range-dialog-demo" => "SUPERDIALOGS.md",
            "notifications-demo" => "SUPERNOTIFICATIONS.md",
            "supergrid-simple-demo" or "supergrid-demo" or "supergrid-vertical-demo" or
                "supergrid-fixed-row-height-demo" or "supergrid-dynamic-component-demo" or
                "todo-supergrid-demo" => "SUPERDATAGRID.md",
            "super-tabs-demo" or "super-tabs-demo/horizontal" or "super-tabs-demo/vertical" or
                "super-tabs-demo/declaratif" => "SUPERTABS.md",
            "splitter-demo" or "splitter-demo/horizontal" or "splitter-demo/vertical" or
                "splitter-demo/both" => "SUPERSPLITTER.md",
            _ => null
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    public async ValueTask DisposeAsync()
    {
        if (_documentationModule is not null)
        {
            await _documentationModule.DisposeAsync();
        }
    }
}
