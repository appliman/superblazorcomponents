@page "/todo-supergrid-demo"
@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDataGrid

<PageTitle>Todo List – SuperDataGrid Edition</PageTitle>

<h1>Todo List</h1>
<p class="text-muted">
    Demonstration of <code>SuperDataGrid</code> in <strong>row-level</strong> edit mode.
    Double-click a row to edit it, or use the action buttons.
    Data is kept in memory for the demo.
</p>

<div class="card mb-3">
    <div class="card-header">New Task</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Title</label>
                <input type="text"
                       class="form-control"
                       placeholder="Task name…"
                       @bind="_newTitle"
                       @bind:event="oninput"
                       @onkeydown="OnNewTitleKeyDownAsync" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Priority</label>
                <select class="form-select" @bind="_newPriority">
                    <option value="Low">Low</option>
                    <option value="Normal">Normal</option>
                    <option value="High">High</option>
                </select>
            </div>
            <div class="col-md-3">
                <SuperButton Text="Add"
                             Icon="fa-plus"
                             Style="SuperButtonStyle.Primary"
                             Click="AddTaskAsync"
                             Disabled="@string.IsNullOrWhiteSpace(_newTitle)" />
            </div>
        </div>
    </div>
</div>

<div style="height: 500px;">
    <SuperDataGrid @ref="_grid"
                   TItem="TodoItem"
                   ItemsProvider="LoadDatas"
                   EditOnDoubleClick="true"
                   Height="100%"
                   RowHeight="50"
                   DisplaySelectionColumn="false"
                   AllowSorting="true"
                   AllowColumnResize="true"
                   AllowColumnReorder="false"
                   AllowFiltering="false"
                   GridId="todo-supergrid-demo"
                   TableCssClass="table-bordered table-hover"
                   DisplayRefreshButton="false"
                   ActionsWidth="70">

        <ActionsTemplate Context="item">
            @if (_grid is not null && _grid.IsRowInEditMode(item))
            {
                <SuperButton Icon="fa-check"
                             Text=""
                             Style="SuperButtonStyle.Success"
                             Size="SuperButtonSize.Small"
                             AllowCollapse="false"
                             title="Confirm"
                             Click="@(async _ => await _grid!.EndEditAsync(item))" />
                <SuperButton Icon="fa-xmark"
                             Text=""
                             Style="SuperButtonStyle.Secondary"
                             Size="SuperButtonSize.Small"
                             AllowCollapse="false"
                             title="Cancel"
                             Click="@(async _ => await _grid!.CancelEditAsync(item))" />
            }
            else
            {
                <SuperButton Icon="fa-pencil"
                             Text=""
                             Style="SuperButtonStyle.Primary"
                             Size="SuperButtonSize.Small"
                             AllowCollapse="false"
                             title="Edit"
                             Click="@(async _ => await _grid!.BeginEditAsync(item))" />
                <SuperButton Icon="fa-trash"
                             Text=""
                             Style="SuperButtonStyle.Danger"
                             Size="SuperButtonSize.Small"
                             AllowCollapse="false"
                             title="Delete"
                             Click="@(async _ => await DeleteTaskAsync(item))" />
            }
        </ActionsTemplate>

        <ChildContent>

            <DataGridColumn TItem="TodoItem" Property="Title" Title="Task" Width="550px">
                <EditTemplate>
                    <input type="text"
                           class="form-control form-control-sm"
                           value="@context.Title"
                           @onchange="@(e => context.Title = e.Value?.ToString() ?? string.Empty)" />
                </EditTemplate>
            </DataGridColumn>

            <DataGridColumn TItem="TodoItem" Property="Priority" Title="Priority" Width="160px" TextAlign="SuperTextAlignment.Center">
                <EditTemplate>
                    <select class="form-select form-select-sm"
                            value="@context.Priority"
                            @onchange="@(e => context.Priority = e.Value?.ToString() ?? "Normal")">
                        <option value="Low">Low</option>
                        <option value="Normal">Normal</option>
                        <option value="High">High</option>
                    </select>
                </EditTemplate>
                <Template>
                    @switch (context.Priority)
                    {
                        case "High":
                            <span class="badge text-bg-danger">High</span>
                            break;
                        case "Low":
                            <span class="badge text-bg-success">Low</span>
                            break;
                        default:
                            <span class="badge text-bg-warning text-dark">Normal</span>
                            break;
                    }
                </Template>
            </DataGridColumn>

            <DataGridColumn TItem="TodoItem" Property="IsCompleted" Title="Completed" Width="110px" TextAlign="SuperTextAlignment.Center">
                <EditTemplate>
                    <input type="checkbox"
                           class="form-check-input"
                           checked="@context.IsCompleted"
                           @onchange="@(async e => { context.IsCompleted = (bool)(e.Value ?? false); await (_grid?.ReloadAsync() ?? Task.CompletedTask); })" />
                </EditTemplate>
                <Template>
                    @if (context.IsCompleted)
                    {
                        <span class="badge text-bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">In progress</span>
                    }
                </Template>
            </DataGridColumn>

            <DataGridColumn TItem="TodoItem" Property="CreatedAt" Title="Created on" Width="160px" FormatString="{0:dd/MM/yyyy HH:mm}" />

        </ChildContent>

        <FooterTemplate>
            <span>
                @_items.Count task(s) — @_items.Count(i => i.IsCompleted) completed — @_items.Count(i => !i.IsCompleted) in progress
            </span>
        </FooterTemplate>

    </SuperDataGrid>
</div>

@code {
    private SuperDataGrid<TodoItem>? _grid;
    private List<TodoItem> _items = [];
    private string _newTitle = string.Empty;
    private string _newPriority = "Normal";
    private int _nextId = 1;

    protected override void OnInitialized()
    {
        _items =
        [
          new TodoItem { Id = _nextId++, Title = "Prepare Monday's meeting", Priority = "High", IsCompleted = false, CreatedAt = DateTimeOffset.Now.AddDays(-2) },
            new TodoItem { Id = _nextId++, Title = "Update the documentation", Priority = "Normal", IsCompleted = false, CreatedAt = DateTimeOffset.Now.AddDays(-1) },
            new TodoItem { Id = _nextId++, Title = "Fix bug #1234", Priority = "High", IsCompleted = true, CreatedAt = DateTimeOffset.Now.AddDays(-3) },
            new TodoItem { Id = _nextId++, Title = "Deploy version 2.1", Priority = "Normal", IsCompleted = false, CreatedAt = DateTimeOffset.Now.AddHours(-5) },
            new TodoItem { Id = _nextId++, Title = "Archive old tasks", Priority = "Low", IsCompleted = false, CreatedAt = DateTimeOffset.Now.AddHours(-1) },
    ];
    }

    private ValueTask<GridItemsProviderResult<TodoItem>> LoadDatas(GridItemsProviderRequest<TodoItem> request)
    {
        var query = _items.AsEnumerable();

        // Text filters
        foreach (var filter in request.Filters)
        {
            if (string.IsNullOrWhiteSpace(filter.PropertyValue))
            {
                continue;
            }

            query = filter.PropertyName switch
            {
                nameof(TodoItem.Title) => query.Where(t => t.Title.Contains(filter.PropertyValue, StringComparison.OrdinalIgnoreCase)),
                nameof(TodoItem.Priority) => query.Where(t => t.Priority.Contains(filter.PropertyValue, StringComparison.OrdinalIgnoreCase)),
                _ => query
            };
        }

        // Sort
        query = (request.SortColumn, request.SortDirection) switch
        {
            (nameof(TodoItem.Title), SortDirection.Ascending)         => query.OrderBy(t => t.Title),
            (nameof(TodoItem.Title), SortDirection.Descending)        => query.OrderByDescending(t => t.Title),
            (nameof(TodoItem.Priority), SortDirection.Ascending)      => query.OrderBy(t => t.Priority),
            (nameof(TodoItem.Priority), SortDirection.Descending)     => query.OrderByDescending(t => t.Priority),
            (nameof(TodoItem.IsCompleted), SortDirection.Ascending)   => query.OrderBy(t => t.IsCompleted),
            (nameof(TodoItem.IsCompleted), SortDirection.Descending)  => query.OrderByDescending(t => t.IsCompleted),
            (nameof(TodoItem.CreatedAt), SortDirection.Ascending)     => query.OrderBy(t => t.CreatedAt),
            (nameof(TodoItem.CreatedAt), SortDirection.Descending)    => query.OrderByDescending(t => t.CreatedAt),
            _                                                          => query
        };

        var totalCount = query.Count();
        var page = query
            .Skip(request.StartIndex)
            .Take(request.Count ?? totalCount)
            .ToList();

        return ValueTask.FromResult(new GridItemsProviderResult<TodoItem>(page, totalCount));
    }

    private async Task AddTaskAsync(Microsoft.AspNetCore.Components.Web.MouseEventArgs _)
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            return;
        }

        _items.Add(new TodoItem
        {
            Id = _nextId++,
            Title = _newTitle.Trim(),
            Priority = _newPriority,
            IsCompleted = false,
            CreatedAt = DateTimeOffset.Now
        });

        _newTitle = string.Empty;
        _newPriority = "Normal";

        if (_grid is not null)
        {
            await _grid.ReloadAsync();
        }
    }

    private async Task DeleteTaskAsync(TodoItem item)
    {
        _items.Remove(item);

        if (_grid is not null)
        {
            await _grid.ReloadAsync();
        }
    }

    private async Task OnNewTitleKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTaskAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs());
        }
    }

    private sealed class TodoItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Priority { get; set; } = "Normal";
        public bool IsCompleted { get; set; }
     public DateTimeOffset CreatedAt { get; set; }
    }
}
