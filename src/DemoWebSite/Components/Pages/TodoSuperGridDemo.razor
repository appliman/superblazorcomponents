@page "/todo-supergrid-demo"
@using Microsoft.AspNetCore.Components.Sections
@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDataGrid

<PageTitle>Todo List - SuperDataGrid</PageTitle>

<SectionContent SectionName="toolbar">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <SuperButton class="me-1" Text="Ajouter" Icon="fa-plus" Style="SuperButtonStyle.Primary" Disabled="false"
                     Click="AddTaskAsync" />

        <div class="vr mx-1 d-none d-md-block"></div>

        <div class="d-flex align-items-center gap-2">
            <label class="form-label m-0" for="status-filter">Statut</label>
            <select id="status-filter" class="form-select form-select-sm w-auto" @bind="_statusFilter"
                    @bind:after="ReloadGridAsync">
                <option value="@TodoStatusFilter.All">Toutes</option>
                <option value="@TodoStatusFilter.Open">En cours</option>
                <option value="@TodoStatusFilter.Done">Terminees</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <label class="form-label m-0" for="priority-filter">Priorite</label>
            <select id="priority-filter" class="form-select form-select-sm w-auto" @bind="_priorityFilter"
                    @bind:after="ReloadGridAsync">
                <option value="">Toutes</option>
                @foreach (var priority in _priorities)
                {
                    <option value="@priority">@priority</option>
                }
            </select>
        </div>

        <SuperButton Text="Reinitialiser" Icon="fa-rotate-left" Style="SuperButtonStyle.Secondary"
                     Size="SuperButtonSize.Small" Outline="true" Click="ResetFiltersAsync" />
    </div>
</SectionContent>

<h1>Todo List</h1>
<p class="text-muted">
    Exemple de todo list editable avec <code>SuperDataGrid</code>. Double-cliquez sur une ligne pour la modifier,
    ou utilisez les actions de chaque ligne. Le bouton Ajouter cree une ligne vide a remplir directement dans la grille.
</p>

<div class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <span class="badge text-bg-primary">@_items.Count tache(s)</span>
    <span class="badge text-bg-success">@CompletedCount terminee(s)</span>
    <span class="badge text-bg-secondary">@OpenCount en cours</span>
</div>

<DemoExample Title="Editable todo grid"
             Description="Editable SuperDataGrid with row actions, toolbar filters, sorting and grid filters."
             Code="@TodoGridCode"
             CodeHeight="640">
<div style="height: 520px;">
    <SuperDataGrid @ref="_grid" TItem="TodoItem" ItemsProvider="LoadTasksAsync" Height="100%" RowHeight="52"
                   OverscanCount="4" GridId="todo-supergrid-demo" EditOnDoubleClick="true" DisplaySelectionColumn="false"
                   DisplayRefreshButton="false" AllowSorting="true" AllowFiltering="true" AllowColumnResize="true"
                   AllowColumnReorder="true" FreezeHeader="true" FreezeFooter="true" ActionsWidth="70"
                   TableCssClass="table-bordered table-hover">

        <ActionsTemplate Context="item">
            @if (_grid is not null && _grid.IsRowInEditMode(item))
            {
                <SuperButton Icon="fa-check" Style="SuperButtonStyle.Success" Size="SuperButtonSize.Small"
                             AllowCollapse="false" title="Valider" Click="@(async _ => await _grid!.EndEditAsync(item))" />
                <SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Secondary" Size="SuperButtonSize.Small"
                             AllowCollapse="false" title="Annuler" Click="@(async _ => await _grid!.CancelEditAsync(item))" />
            }
            else
            {
                <SuperButton Icon="fa-pencil" Style="SuperButtonStyle.Primary" Size="SuperButtonSize.Small"
                             AllowCollapse="false" title="Modifier" Click="@(async _ => await _grid!.BeginEditAsync(item))" />
                <SuperButton Icon="fa-trash" Style="SuperButtonStyle.Danger" Size="SuperButtonSize.Small"
                             AllowCollapse="false" title="Supprimer" Click="@(async _ => await DeleteTaskAsync(item))" />
            }
        </ActionsTemplate>

        <ChildContent>
            <DataGridColumn For="@(task => task.Title)" Title="Tache" Width="360px" AlwaysVisible="true">
                <EditTemplate>
                    <input type="text" class="form-control form-control-sm" value="@context.Title"
                           @onchange="@(e => context.Title = e.Value?.ToString() ?? string.Empty)" />
                </EditTemplate>
                <Template>
                    <span class="@(context.IsCompleted ? "text-decoration-line-through text-muted" : null)">
                        @context.Title
                    </span>
                </Template>
            </DataGridColumn>

            <DataGridColumn For="@(task => task.Owner)" Title="Responsable" Width="180px">
                <EditTemplate>
                    <input type="text" class="form-control form-control-sm" value="@context.Owner"
                           @onchange="@(e => context.Owner = e.Value?.ToString() ?? string.Empty)" />
                </EditTemplate>
            </DataGridColumn>

            <DataGridColumn For="@(task => task.Priority)" Title="Priorite" Width="140px"
                            TextAlign="SuperTextAlignment.Center">
                <EditTemplate>
                    <select class="form-select form-select-sm" value="@context.Priority"
                            @onchange="@(e => context.Priority = e.Value?.ToString() ?? NormalPriority)">
                        @foreach (var priority in _priorities)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </EditTemplate>
                <Template>
                    <span class="@GetPriorityBadgeClass(context.Priority)">@context.Priority</span>
                </Template>
            </DataGridColumn>

            <DataGridColumn For="@(task => task.IsCompleted)" Title="Statut" Width="150px"
                            TextAlign="SuperTextAlignment.Center">
                <EditTemplate>
                    <div class="form-check d-flex justify-content-center">
                        <input type="checkbox" class="form-check-input" checked="@context.IsCompleted"
                               @onchange="@(async e => await ToggleCompletedAsync(context, e))" />
                    </div>
                </EditTemplate>
                <Template>
                    @if (context.IsCompleted)
                    {
                        <span class="badge text-bg-success">Terminee</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">En cours</span>
                    }
                </Template>
            </DataGridColumn>

            <DataGridColumn For="@(task => task.DueDate)" Title="Echeance" Width="160px" FormatString="{0:dd/MM/yyyy}"
                            TextAlign="SuperTextAlignment.Center">
                <EditTemplate>
                    <input type="date" class="form-control form-control-sm"
                           value="@context.DueDate.ToString("yyyy-MM-dd")"
                           @onchange="@(e => UpdateDueDate(context, e.Value?.ToString()))" />
                </EditTemplate>
            </DataGridColumn>

            <DataGridColumn For="@(task => task.CreatedAt)" Title="Creation" Width="160px"
                            FormatString="{0:dd/MM/yyyy HH:mm}" />
        </ChildContent>

        <FooterTemplate>
            <span>@FilteredFooterText</span>
        </FooterTemplate>
    </SuperDataGrid>
</div>
</DemoExample>

@code {
    private const string TodoGridCode = """
    <SuperDataGrid @ref="_grid"
                   TItem="TodoItem"
                   ItemsProvider="LoadTasksAsync"
                   Height="100%"
                   RowHeight="52"
                   GridId="todo-supergrid-demo"
                   EditOnDoubleClick="true"
                   DisplaySelectionColumn="false"
                   AllowSorting="true"
                   AllowFiltering="true"
                   AllowColumnResize="true"
                   AllowColumnReorder="true"
                   FreezeHeader="true"
                   FreezeFooter="true"
                   ActionsWidth="70">
        <ActionsTemplate Context="item">
            @if (_grid is not null && _grid.IsRowInEditMode(item))
            {
                <SuperButton Icon="fa-check" Style="SuperButtonStyle.Success" Size="SuperButtonSize.Small"
                             Click="@(async _ => await _grid!.EndEditAsync(item))" />
                <SuperButton Icon="fa-xmark" Style="SuperButtonStyle.Secondary" Size="SuperButtonSize.Small"
                             Click="@(async _ => await _grid!.CancelEditAsync(item))" />
            }
            else
            {
                <SuperButton Icon="fa-pencil" Style="SuperButtonStyle.Primary" Size="SuperButtonSize.Small"
                             Click="@(async _ => await _grid!.BeginEditAsync(item))" />
            }
        </ActionsTemplate>
        <ChildContent>
            <DataGridColumn For="@(task => task.Title)" Title="Tache" Width="360px" AlwaysVisible="true">
                <EditTemplate>
                    <input type="text" class="form-control form-control-sm" value="@context.Title"
                           @onchange="@(e => context.Title = e.Value?.ToString() ?? string.Empty)" />
                </EditTemplate>
            </DataGridColumn>
            <DataGridColumn For="@(task => task.Priority)" Title="Priorite" Width="140px">
                <Template>
                    <span class="@GetPriorityBadgeClass(context.Priority)">@context.Priority</span>
                </Template>
            </DataGridColumn>
            <DataGridColumn For="@(task => task.DueDate)" Title="Echeance" Width="160px" FormatString="{0:dd/MM/yyyy}" />
        </ChildContent>
    </SuperDataGrid>
    """;

    private const string LowPriority = "Basse";
    private const string NormalPriority = "Normale";
    private const string HighPriority = "Haute";

    private static readonly string[] _priorities = [LowPriority, NormalPriority, HighPriority];

    private SuperDataGrid<TodoItem>? _grid;
    private readonly List<TodoItem> _items = [];
    private string _priorityFilter = string.Empty;
    private TodoStatusFilter _statusFilter = TodoStatusFilter.All;
    private int _nextId = 1;
    private int _filteredCount;

    private int CompletedCount => _items.Count(item => item.IsCompleted);

    private int OpenCount => _items.Count - CompletedCount;

    private string FilteredFooterText => $"{_filteredCount} tache(s) affichee(s) sur {_items.Count}";

    protected override void OnInitialized()
    {
        _items.AddRange(
        [
            NewTask("Preparer la revue produit", "Alice", HighPriority, false, DateTimeOffset.Now.AddDays(1),
DateTimeOffset.Now.AddDays(-3)),
            NewTask("Finaliser la documentation", "Bruno", NormalPriority, false, DateTimeOffset.Now.AddDays(3),
DateTimeOffset.Now.AddDays(-2)),
            NewTask("Verifier les retours QA", "Claire", HighPriority, true, DateTimeOffset.Now.AddDays(-1),
DateTimeOffset.Now.AddDays(-5)),
            NewTask("Nettoyer les anciens exemples", "David", LowPriority, false, DateTimeOffset.Now.AddDays(8),
DateTimeOffset.Now.AddDays(-1)),
            NewTask("Publier la version de demo", "Emma", NormalPriority, false, DateTimeOffset.Now.AddDays(5),
DateTimeOffset.Now.AddHours(-8))
        ]);

        _filteredCount = _items.Count;
    }

    private ValueTask<GridItemsProviderResult<TodoItem>> LoadTasksAsync(GridItemsProviderRequest<TodoItem> request)
    {
        IEnumerable<TodoItem> query = _items;

        query = ApplyToolbarFilters(query);
        query = ApplyGridFilters(query, request.Filters);
        query = ApplySort(query, request.SortColumn, request.SortDirection);

        var filteredItems = query.ToList();
        _filteredCount = filteredItems.Count;

        var items = filteredItems
            .Skip(request.StartIndex)
            .Take(request.Count ?? filteredItems.Count)
            .ToList();

        return ValueTask.FromResult(GridItemsProviderResult<TodoItem>.From(items, _filteredCount));
    }

    private IEnumerable<TodoItem> ApplyToolbarFilters(IEnumerable<TodoItem> query)
    {
        query = _statusFilter switch
        {
            TodoStatusFilter.Open => query.Where(task => !task.IsCompleted),
            TodoStatusFilter.Done => query.Where(task => task.IsCompleted),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(_priorityFilter))
        {
            query = query.Where(task => task.Priority == _priorityFilter);
        }

        return query;
    }

    private static IEnumerable<TodoItem> ApplyGridFilters(
        IEnumerable<TodoItem> query,
        IEnumerable<SuperDataGridFilterInfo> filters)
    {
        foreach (var filter in filters)
        {
            if (filter.PropertyName == nameof(TodoItem.Title) && !string.IsNullOrWhiteSpace(filter.PropertyValue))
            {
                query = query.Where(task => task.Title.Contains(filter.PropertyValue, StringComparison.OrdinalIgnoreCase));
            }
            else if (filter.PropertyName == nameof(TodoItem.Owner) && !string.IsNullOrWhiteSpace(filter.PropertyValue))
            {
                query = query.Where(task => task.Owner.Contains(filter.PropertyValue, StringComparison.OrdinalIgnoreCase));
            }
            else if (filter.PropertyName == nameof(TodoItem.Priority) && !string.IsNullOrWhiteSpace(filter.PropertyValue))
            {
                query = query.Where(task => task.Priority.Contains(filter.PropertyValue, StringComparison.OrdinalIgnoreCase));
            }
            else if (filter.PropertyName == nameof(TodoItem.IsCompleted) && bool.TryParse(filter.PropertyValue, out var
isCompleted))
            {
                query = query.Where(task => task.IsCompleted == isCompleted);
            }
            else if (filter.PropertyName == nameof(TodoItem.DueDate))
            {
                query = ApplyDateRangeFilter(query, task => task.DueDate, filter);
            }
            else if (filter.PropertyName == nameof(TodoItem.CreatedAt))
            {
                query = ApplyDateRangeFilter(query, task => task.CreatedAt, filter);
            }
        }

        return query;
    }

    private static IEnumerable<TodoItem> ApplyDateRangeFilter(
        IEnumerable<TodoItem> query,
        Func<TodoItem, DateTimeOffset> selector,
        SuperDataGridFilterInfo filter)
    {
        if (filter.StartDate is not null)
        {
            var startDate = filter.StartDate.Value;
            query = query.Where(task => selector(task) >= startDate);
        }

        if (filter.EndDate is not null)
        {
            var endDate = filter.EndDate.Value;
            query = query.Where(task => selector(task) <= endDate);
        }

        return query;
    }

    private static IEnumerable<TodoItem> ApplySort(
        IEnumerable<TodoItem> query,
        string? sortColumn,
        SortDirection sortDirection)
    {
        return (sortColumn, sortDirection) switch
        {
            (nameof(TodoItem.Title), SortDirection.Ascending) => query.OrderBy(task => task.Title),
            (nameof(TodoItem.Title), SortDirection.Descending) => query.OrderByDescending(task => task.Title),
            (nameof(TodoItem.Owner), SortDirection.Ascending) => query.OrderBy(task => task.Owner),
            (nameof(TodoItem.Owner), SortDirection.Descending) => query.OrderByDescending(task => task.Owner),
            (nameof(TodoItem.Priority), SortDirection.Ascending) => query.OrderBy(task => task.Priority),
            (nameof(TodoItem.Priority), SortDirection.Descending) => query.OrderByDescending(task => task.Priority),
            (nameof(TodoItem.IsCompleted), SortDirection.Ascending) => query.OrderBy(task => task.IsCompleted),
            (nameof(TodoItem.IsCompleted), SortDirection.Descending) => query.OrderByDescending(task => task.IsCompleted),
            (nameof(TodoItem.DueDate), SortDirection.Ascending) => query.OrderBy(task => task.DueDate),
            (nameof(TodoItem.DueDate), SortDirection.Descending) => query.OrderByDescending(task => task.DueDate),
            (nameof(TodoItem.CreatedAt), SortDirection.Ascending) => query.OrderBy(task => task.CreatedAt),
            (nameof(TodoItem.CreatedAt), SortDirection.Descending) => query.OrderByDescending(task => task.CreatedAt),
            _ => query.OrderBy(task => task.IsCompleted).ThenByDescending(task => task.Priority == HighPriority).ThenBy(task =>
task.DueDate)
        };
    }

    private async Task AddTaskAsync(MouseEventArgs _)
    {
        await AddTaskCoreAsync();
    }

    private async Task AddTaskCoreAsync()
    {
        var newTask = NewTask(
            string.Empty,
            string.Empty,
            NormalPriority,
            false,
            DateTimeOffset.Now.Date,
            DateTimeOffset.Now);

        _items.Add(newTask);
        _statusFilter = TodoStatusFilter.All;
        _priorityFilter = string.Empty;

        await ReloadGridAsync();

        if (_grid is not null)
        {
            await _grid.BeginEditAsync(newTask);
        }
    }

    private async Task DeleteTaskAsync(TodoItem item)
    {
        _items.Remove(item);
        await ReloadGridAsync();
    }

    private async Task ToggleCompletedAsync(TodoItem item, ChangeEventArgs e)
    {
        item.IsCompleted = e.Value is bool value && value;
        await ReloadGridAsync();
    }

    private void UpdateDueDate(TodoItem item, string? value)
    {
        if (DateTimeOffset.TryParse(value, out var dueDate))
        {
            item.DueDate = dueDate;
        }
    }

    private async Task ResetFiltersAsync(MouseEventArgs _)
    {
        _statusFilter = TodoStatusFilter.All;
        _priorityFilter = string.Empty;
        await ReloadGridAsync();
    }

    private async Task ReloadGridAsync()
    {
        if (_grid is not null)
        {
            await _grid.ReloadAsync();
        }
    }

    private TodoItem NewTask(
        string title,
        string owner,
        string priority,
        bool isCompleted,
        DateTimeOffset dueDate,
        DateTimeOffset createdAt)
    {
        return new TodoItem
        {
            Id = _nextId++,
            Title = title,
            Owner = owner,
            Priority = priority,
            IsCompleted = isCompleted,
            DueDate = dueDate,
            CreatedAt = createdAt
        };
    }

    private static string GetPriorityBadgeClass(string priority)
    {
        return priority switch
        {
            HighPriority => "badge text-bg-danger",
            LowPriority => "badge text-bg-light border text-dark",
            _ => "badge text-bg-warning text-dark"
        };
    }

    private enum TodoStatusFilter
    {
        All,
        Open,
        Done
    }

    private sealed class TodoItem : IDataItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Owner { get; set; } = string.Empty;
        public string Priority { get; set; } = NormalPriority;
        public bool IsCompleted { get; set; }
        public DateTimeOffset DueDate { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
        public object KeyValue => Id;
        public bool IsSelected { get; set; }
        public int RowNumber { get; set; }
    }
}
