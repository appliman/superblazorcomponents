@page "/forms-demo"
@using SuperBlazorComponents.Components.Forms
@using SuperBlazorComponents.Components.SuperTriStateCheckbox

<PageTitle>Forms Demo</PageTitle>

<h1>Forms Demo</h1>

<p class="text-muted">
    Démonstration des composants de formulaire — <code>SuperSwitch</code> et <code>SuperTriStateCheckbox</code>.
</p>

@* ── SuperSwitch ──────────────────────────────────────────────────────────── *@

<h2 class="mt-4">SuperSwitch</h2>

<div class="card mt-3">
    <div class="card-header">Basique</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Utilisation minimale : un <code>SuperSwitch</code> avec <code>@("@bind-Value")</code>.
        </p>

        <SuperSwitch Label="Activer les notifications" @bind-Value="_basicValue" />

        <div class="alert alert-light border mt-3 mb-0">
            Valeur : <strong>@_basicValue</strong>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Sans label</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Le <code>Label</code> est optionnel.
        </p>

        <SuperSwitch @bind-Value="_noLabelValue" />

        <div class="alert alert-light border mt-3 mb-0">
            Valeur : <strong>@_noLabelValue</strong>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Avec texte d'aide</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Le paramètre <code>HelpText</code> affiche un texte d'aide sous le switch.
        </p>

        <SuperSwitch Label="Mode sombre"
                     HelpText="Applique un thème sombre à toute l'interface."
                     @bind-Value="_helpTextValue" />

        <div class="alert alert-light border mt-3 mb-0">
            Valeur : <strong>@_helpTextValue</strong>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Désactivé</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Le paramètre <code>Disabled</code> empêche toute interaction.
        </p>

        <div class="d-flex flex-column gap-2">
            <SuperSwitch Label="Désactivé (off)" Disabled="true" Value="false" />
            <SuperSwitch Label="Désactivé (on)"  Disabled="true" Value="true" />
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Position du label</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Le paramètre <code>LabelPosition</code> place le label à droite (<code>Right</code>, défaut)
            ou à gauche (<code>Left</code>) grâce à la classe Bootstrap <code>form-check-reverse</code>.
        </p>

        <div class="d-flex flex-column gap-2">
            <SuperSwitch Label="Label à droite (défaut)" @bind-Value="_labelRightValue" />
            <SuperSwitch Label="Label à gauche" LabelPosition="SuperSwitchLabelPosition.Left" @bind-Value="_labelLeftValue" />
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Callback explicite</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Utilisation de <code>Value</code> + <code>ValueChanged</code> pour intercepter le changement.
        </p>

        <SuperSwitch Label="Journalisation activée"
                     Value="@_callbackValue"
                     ValueChanged="OnCallbackValueChangedAsync" />

        <ul class="list-group mt-3">
            @foreach (var entry in _log)
            {
                <li class="list-group-item py-1 small">@entry</li>
            }
        </ul>
    </div>
</div>

@* ── SuperTriStateCheckbox ───────────────────────────────────────────────── *@

<h2 class="mt-5">SuperTriStateCheckbox</h2>

<div class="card mt-3">
    <div class="card-header">Basique</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Chaque clic fait tourner la valeur dans l'ordre <code>null</code>, <code>true</code>, <code>false</code>.
        </p>

        <SuperTriStateCheckbox Label="Filtre validé"
                               HelpText="État indéterminé, oui ou non."
                               @bind-Value="_triStateValue" />

        <div class="alert alert-light border mt-3 mb-0">
            Valeur : <strong>@FormatNullableBool(_triStateValue)</strong>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Styles Bootstrap</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Le composant conserve les classes Bootstrap <code>form-check</code> et <code>form-check-input</code>,
            avec des classes additionnelles configurables.
        </p>

        <SuperTriStateCheckbox Label="Décision revue"
                               CssClass="border-primary"
                               LabelCssClass="fw-semibold text-primary"
                               HelpTextCssClass="text-primary"
                               HelpText="Exemple avec classes CSS Bootstrap."
                               @bind-Value="_styledTriStateValue" />

        <div class="alert alert-light border mt-3 mb-0">
            Valeur : <strong>@FormatNullableBool(_styledTriStateValue)</strong>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Callback explicite</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Utilisation de <code>Value</code> + <code>ValueChanged</code> pour intercepter le changement.
        </p>

        <SuperTriStateCheckbox Label="Validation optionnelle"
                               Value="@_triStateCallbackValue"
                               ValueChanged="OnTriStateCallbackValueChangedAsync" />

        <ul class="list-group mt-3">
            @foreach (var entry in _triStateLog)
            {
                <li class="list-group-item py-1 small">@entry</li>
            }
        </ul>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">Dans un formulaire avec validation</div>
    <div class="card-body">
        <p class="text-muted mb-3">
            Intégration dans un <code>EditForm</code> avec <code>DataAnnotationsValidator</code>
            et <code>ValueExpression</code>.
        </p>

        <EditForm Model="_formModel" OnValidSubmit="OnFormSubmitAsync">
            <DataAnnotationsValidator />

            <SuperSwitch Label="J'accepte les conditions d'utilisation"
                         @bind-Value="_formModel.AcceptTerms" />

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Valider</button>
            </div>

            @if (_formSubmitted)
            {
                <div class="alert alert-success mt-3 mb-0">
                    Formulaire soumis avec succès !
                </div>
            }
        </EditForm>
    </div>
</div>

@code {
    private bool _basicValue;
    private bool _noLabelValue;
    private bool _helpTextValue;
    private bool _labelRightValue;
    private bool _labelLeftValue;
    private bool _callbackValue;
    private readonly List<string> _log = [];
    private bool? _triStateValue;
    private bool? _styledTriStateValue = true;
    private bool? _triStateCallbackValue;
    private readonly List<string> _triStateLog = [];
    private bool _formSubmitted;

    private readonly FormModel _formModel = new();

    private Task OnCallbackValueChangedAsync(bool newValue)
    {
        _callbackValue = newValue;
        _log.Insert(0, $"{DateTime.Now:HH:mm:ss} → {newValue}");

        if (_log.Count > 5)
        {
            _log.RemoveAt(_log.Count - 1);
        }

        return Task.CompletedTask;
    }

    private Task OnTriStateCallbackValueChangedAsync(bool? newValue)
    {
        _triStateCallbackValue = newValue;
        _triStateLog.Insert(0, $"{DateTime.Now:HH:mm:ss} → {FormatNullableBool(newValue)}");

        if (_triStateLog.Count > 5)
        {
            _triStateLog.RemoveAt(_triStateLog.Count - 1);
        }

        return Task.CompletedTask;
    }

    private Task OnFormSubmitAsync()
    {
        _formSubmitted = true;
        return Task.CompletedTask;
    }

    private static string FormatNullableBool(bool? value)
    {
        return value switch
        {
            true => "true",
            false => "false",
            null => "null"
        };
    }

    private sealed class FormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Vous devez accepter les conditions.")]
        [System.ComponentModel.DataAnnotations.Range(typeof(bool), "true", "true",
            ErrorMessage = "Vous devez accepter les conditions.")]
        public bool AcceptTerms { get; set; }
    }
}
