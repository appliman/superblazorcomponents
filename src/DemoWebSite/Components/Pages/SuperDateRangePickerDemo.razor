@page "/super-date-range-picker-demo"
@using System.Globalization
@using SuperBlazorComponents.Components
@using SuperBlazorComponents.Components.SuperDateRange

<PageTitle>SuperDateRangePicker</PageTitle>

<h1>SuperDateRangePicker</h1>

<p class="text-muted">
    Sélecteur de période inspiré de Google Ads avec périodes prédéfinies, sélection personnalisée et bornes nullables.
</p>

<div class="card mt-3">
    <div class="card-header">
        Démonstration
    </div>
    <div class="card-body">
        <div class="d-flex flex-column gap-3 align-items-start">
            <SuperDateRangePicker @bind-Value="_selectedRange" Applied="OnAppliedAsync" />

            <div class="row g-3 w-100">
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100 bg-body-tertiary">
                        <div class="small text-body-secondary">Preset</div>
                        <div class="fw-semibold">@GetPresetLabel(_selectedRange.Preset)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100 bg-body-tertiary">
                        <div class="small text-body-secondary">Date de début</div>
                        <div class="fw-semibold">@GetDateText(_selectedRange.StartDate)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100 bg-body-tertiary">
                        <div class="small text-body-secondary">Date de fin</div>
                        <div class="fw-semibold">@GetDateText(_selectedRange.EndDate)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3 h-100 bg-body-tertiary">
                        <div class="small text-body-secondary">Dernière validation</div>
                        <div class="fw-semibold">@_lastAppliedSummary</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");

    private SuperDateRangeSelection _selectedRange = new(null, null, SuperDateRangePreset.AllTime);
    private string _lastAppliedSummary = "Toute la période";

    private Task OnAppliedAsync(SuperDateRangeSelection range)
    {
        _lastAppliedSummary = GetSummaryText(range);
        return Task.CompletedTask;
    }

    private static string GetDateText(DateTime? value)
    {
        return value?.ToString("d MMM yyyy", FrCulture) ?? "Non définie";
    }

    private static string GetSummaryText(SuperDateRangeSelection range)
    {
        if (range.StartDate is null && range.EndDate is null)
        {
            return "Toute la période";
        }

        if (range.StartDate is not null && range.EndDate is not null)
        {
            if (range.StartDate == range.EndDate)
            {
                return range.StartDate.Value.ToString("d MMM yyyy", FrCulture);
            }

            return $"{range.StartDate.Value.ToString("d MMM yyyy", FrCulture)} - {range.EndDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        if (range.StartDate is not null)
        {
            return $"Depuis le {range.StartDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        return $"Jusqu'au {range.EndDate!.Value.ToString("d MMM yyyy", FrCulture)}";
    }

    private static string GetPresetLabel(SuperDateRangePreset preset)
    {
        return preset switch
        {
            SuperDateRangePreset.Today => "Aujourd'hui",
            SuperDateRangePreset.Yesterday => "Hier",
            SuperDateRangePreset.ThisWeek => "Cette semaine",
            SuperDateRangePreset.LastWeek => "Semaine dernière",
            SuperDateRangePreset.Last7Days => "7 derniers jours",
            SuperDateRangePreset.Last14Days => "14 derniers jours",
            SuperDateRangePreset.Last30Days => "30 derniers jours",
            SuperDateRangePreset.Last90Days => "90 derniers jours",
            SuperDateRangePreset.ThisMonth => "Ce mois-ci",
            SuperDateRangePreset.LastMonth => "Mois dernier",
            SuperDateRangePreset.ThisQuarter => "Ce trimestre",
            SuperDateRangePreset.LastQuarter => "Trimestre dernier",
            SuperDateRangePreset.ThisYear => "Cette année",
            SuperDateRangePreset.LastYear => "Année dernière",
            SuperDateRangePreset.AllTime => "Toute la période",
            _ => "Personnalisée"
        };
    }
}
