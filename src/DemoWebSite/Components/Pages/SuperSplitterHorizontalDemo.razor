@page "/splitter-demo/horizontal"
@using SuperBlazorComponents.Components.SuperSplitter

<PageTitle>SuperSplitter Horizontal</PageTitle>

<h1>SuperSplitter - Horizontal</h1>

<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <span>1st pane size: <strong>@FirstPaneSize.ToString("0")%</strong></span>
</div>

<div style="height: 65vh; min-height: 320px; border: 1px solid var(--bs-border-color); border-radius: 0.375rem; overflow: hidden;">
    <SuperSplitter Orientation="@SuperSplitterOrientation.Horizontal"
                  FirstPaneSize="@FirstPaneSize"
                  FirstPaneSizeChanged="@OnFirstPaneSizeChanged"
                  MinFirstPaneSize="10"
                  MaxFirstPaneSize="90"
                  PersistenceKey="AdminBlazorApp:SuperSplitterDemo:Horizontal">
        <SplitPane>
            <div class="h-100 p-3" style="background-color: var(--bs-tertiary-bg);">
                <h5 class="mb-2">Pane 1</h5>
                <p class="mb-0">Drag the bar to resize.</p>
            </div>
        </SplitPane>
        <SplitPane>
            <div class="h-100 p-3">
                <h5 class="mb-2">Pane 2</h5>
                <p class="mb-0">Orientation: <strong>Horizontal</strong></p>
            </div>
        </SplitPane>
    </SuperSplitter>
</div>

@code {
    private double FirstPaneSize { get; set; } = 35;

    private Task OnFirstPaneSizeChanged(double value)
    {
        FirstPaneSize = value;
        return Task.CompletedTask;
    }
}
