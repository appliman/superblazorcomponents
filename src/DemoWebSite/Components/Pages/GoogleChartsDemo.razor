    private readonly GoogleChartOptions _mixedOptions = new()
    {
        Title = "Revenue and Conversion",
        DefaultSeriesType = GoogleChartSeriesType.Columns,
        HAxisTitle = "Month",
        VAxisTitle = "Revenue (k€)",
        VAxis2Title = "Conversion",
        VAxis2Format = "percent",
        Height = "320",
        ChartAreaBackgroundColor = "#f5f5f5",
        HAxisGridlinesColor = "#d0d0d0",
        VAxisGridlinesColor = "#d0d0d0",
        Series = new Dictionary<int, GoogleChartSeries>
        {
            [0] = new GoogleChartSeries { Type = GoogleChartSeriesType.Columns, Color = "#00897b" },
            [1] = new GoogleChartSeries
            {
                Type = GoogleChartSeriesType.Line,
                Color = "#f4511e",
                LineWidth = 3,
                PointSize = 5,
                TargetAxisIndex = 1
            }
        }
    };

    private static DateTimeOffset CreateDate(int year, int month, int day)
    {
        return new DateTimeOffset(year, month, day, 0, 0, 0, TimeSpan.Zero);
    }
}
