       new GoogleChartDataRow { Label = CreateDate(2024, 1, 1), Values = [980m, 0.054m] },
        new GoogleChartDataRow { Label = CreateDate(2024, 2, 1), Values = [1040m, 0.061m] },
        new GoogleChartDataRow { Label = CreateDate(2024, 3, 1), Values = [1110m, 0.067m] },
        new GoogleChartDataRow { Label = CreateDate(2024, 4, 1), Values = [1060m, 0.058m] },
        new GoogleChartDataRow { Label = CreateDate(2024, 5, 1), Values = [1180m, 0.071m] },
