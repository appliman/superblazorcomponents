@page "/supertooltip-demo"
@using SuperBlazorComponents.Components.Tooltips

<PageTitle>SuperTooltip Demo</PageTitle>

<h1>SuperTooltip Demo</h1>

<p class="text-muted">
    Tooltips texte, HTML, Markdown, positions, delais et fermeture au clic de page.
</p>

<div class="card mt-3">
    <div class="card-header">
        Message texte
    </div>
    <div class="card-body">
        <SuperTooltip Text="Message texte simple au survol">
            <button class="btn btn-primary">Show tooltip</button>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Positions
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <SuperTooltip Text="Tooltip a gauche" Position="SuperTooltipPosition.Left">
                <button class="btn btn-outline-secondary">Left</button>
            </SuperTooltip>

            <SuperTooltip Text="Tooltip en haut" Position="SuperTooltipPosition.Top">
                <button class="btn btn-outline-secondary">Top</button>
            </SuperTooltip>

            <SuperTooltip Text="Tooltip en bas" Position="SuperTooltipPosition.Bottom">
                <button class="btn btn-outline-secondary">Bottom</button>
            </SuperTooltip>

            <SuperTooltip Text="Tooltip a droite" Position="SuperTooltipPosition.Right">
                <button class="btn btn-outline-secondary">Right</button>
            </SuperTooltip>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Contenu HTML
    </div>
    <div class="card-body">
        <SuperTooltip HtmlContent="<strong>HTML content</strong><br><span class='text-warning'>Avec mise en forme Bootstrap</span>"
                      Position="SuperTooltipPosition.Right">
            <button class="btn btn-warning">Show HTML tooltip</button>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Markdown
    </div>
    <div class="card-body">
        <SuperTooltip Markdown="@MarkdownContent"
                      Position="SuperTooltipPosition.Right"
                      TooltipCssClass="super-tooltip-demo-markdown">
            <button class="btn btn-info">Show Markdown tooltip</button>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Delai et duree
    </div>
    <div class="card-body">
        <SuperTooltip Text="Ouverture apres 600 ms, fermeture automatique apres 5 secondes"
                      Delay="600"
                      Duration="5000">
            <button class="btn btn-secondary">Show delayed tooltip</button>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Clic et fermeture sur la page
    </div>
    <div class="card-body">
        <SuperTooltip Text="Cliquez ailleurs dans la page pour fermer ce tooltip"
                      Trigger="SuperTooltipTrigger.Click"
                      CloseOnDocumentClick="true"
                      Position="SuperTooltipPosition.Bottom"
                      TooltipStyle="--bs-tooltip-bg: var(--bs-primary); --bs-tooltip-color: #fff;">
            <button class="btn btn-dark">Click to show tooltip</button>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Element HTML
    </div>
    <div class="card-body">
        <SuperTooltip Text="Tooltip sur un element HTML natif">
            <span class="text-decoration-underline text-primary" role="button" tabindex="0">Show tooltip</span>
        </SuperTooltip>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        Controle manuel
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <SuperTooltip @ref="_manualTooltip"
                          Text="Tooltip affiche via ShowAsync, HideAsync ou ToggleAsync"
                          Trigger="SuperTooltipTrigger.Manual"
                          Position="SuperTooltipPosition.Right">
                <button class="btn btn-outline-primary">Target</button>
            </SuperTooltip>

            <button class="btn btn-sm btn-primary" @onclick="ShowManualTooltipAsync">Show</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="HideManualTooltipAsync">Hide</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="ToggleManualTooltipAsync">Toggle</button>
        </div>
    </div>
</div>

@code
{
    private SuperTooltip? _manualTooltip;

    private const string MarkdownContent = """
    ### Details
    - Supporte **gras** et *italique*
    - Affiche du `code inline`
    - Ouvre les liens HTTP : [Appliman](https://www.appliman.com)
    """;

    private Task ShowManualTooltipAsync()
    {
        return _manualTooltip?.ShowAsync() ?? Task.CompletedTask;
    }

    private Task HideManualTooltipAsync()
    {
        return _manualTooltip?.HideAsync() ?? Task.CompletedTask;
    }

    private Task ToggleManualTooltipAsync()
    {
        return _manualTooltip?.ToggleAsync() ?? Task.CompletedTask;
    }
}
