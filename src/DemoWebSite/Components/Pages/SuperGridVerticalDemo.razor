@page "/supergrid-vertical-demo"
@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDataGrid

<PageTitle>SuperGrid – Vertical Demo</PageTitle>

<h1>SuperGrid – Vertical Orientation</h1>
<p class="text-muted">
    In <code>Vertical</code> mode, each record is displayed as a property grid
    with 3 columns: <strong>#</strong> (number), <strong>Property</strong> (title) and <strong>Value</strong>.
    Double-click an item or use the <i class="fa-solid fa-pencil"></i> button to edit it.
</p>

<div class="row">
    <div class="col-md-6">
        <h4 class="mt-3">Vertical</h4>
        <p class="text-muted">Mode grille de propriétés — un bloc par enregistrement.</p>
        <div style="height: 500px;">
            <SuperDataGrid @ref="_gridVertical"
                           TItem="Produit"
                           ItemsProvider="LoadProduitsAsync"
                           GridOrientation="SuperDataGridOrientation.Vertical"
                           Height="100%"
                           RowHeight="50"
                           EditOnDoubleClick="true"
                           AllowSorting="false"
                           AllowFiltering="false"
                           AllowColumnReorder="false"
                           AllowColumnResize="false"
                           DisplaySelectionColumn="false"
                           DisplayColumnVisibilityToggle="false"
                           CurrentRowBackground="#3b95c6"
                           TableCssClass="table-bordered">
                <ActionsTemplate Context="item">
                    @if (_gridVertical is not null && _gridVertical.IsRowInEditMode(item))
                    {
                        <SuperButton Icon="fa-check"
                                     Text=""
                                     Style="SuperButtonStyle.Success"
                                     Size="SuperButtonSize.Small"
                                     AllowCollapse="false"
                                     title="Confirm"
                                     Click="@(async _ => await _gridVertical!.EndEditAsync(item))" />
                        <SuperButton Icon="fa-xmark"
                                     Text=""
                                     Style="SuperButtonStyle.Secondary"
                                     Size="SuperButtonSize.Small"
                                     AllowCollapse="false"
                                     title="Cancel"
                                     Click="@(async _ => await _gridVertical!.CancelEditAsync(item))" />
                    }
                    else
                    {
                        <SuperButton Icon="fa-pencil"
                                     Text=""
                                     Style="SuperButtonStyle.Primary"
                                     Size="SuperButtonSize.Small"
                                     AllowCollapse="false"
                                     title="Edit"
                                     Click="@(async _ => await _gridVertical!.BeginEditAsync(item))" />
                    }
                </ActionsTemplate>
                <ChildContent>
                    <DataGridColumn TItem="Produit" For="@(p => p.Reference)" Title="Reference">
                        <EditTemplate>
                            <input type="text" class="form-control form-control-sm"
                                   value="@context.Reference"
                                   @onchange="@(e => context.Reference = e.Value?.ToString() ?? string.Empty)" />
                        </EditTemplate>
                    </DataGridColumn>
                    <DataGridColumn TItem="Produit" For="@(p => p.Nom)" Title="Name">
                        <EditTemplate>
                            <input type="text" class="form-control form-control-sm"
                                   value="@context.Nom"
                                   @onchange="@(e => context.Nom = e.Value?.ToString() ?? string.Empty)" />
                        </EditTemplate>
                    </DataGridColumn>
                    <DataGridColumn TItem="Produit" For="@(p => p.Categorie)" Title="Category">
                        <EditTemplate>
                            <select class="form-select form-select-sm"
                                    value="@context.Categorie"
                                    @onchange="@(e => context.Categorie = e.Value?.ToString() ?? string.Empty)">
                                <option>Accessories</option>
                                <option>Audio</option>
                                <option>Energy</option>
                                <option>Furniture</option>
                                <option>Monitors</option>
                                <option>Peripherals</option>
                                <option>Protection</option>
                                <option>Storage</option>
                                <option>Video</option>
                            </select>
                        </EditTemplate>
                    </DataGridColumn>
                    <DataGridColumn TItem="Produit" For="@(p => p.PrixUnitaire)" Title="Unit Price" FormatString="{0:C}">
                        <EditTemplate>
                            <input type="number" class="form-control form-control-sm"
                                   value="@context.PrixUnitaire"
                                   @onchange="@(e => context.PrixUnitaire = decimal.TryParse(e.Value?.ToString(), out var v) ? v : context.PrixUnitaire)" />
                        </EditTemplate>
                    </DataGridColumn>
                    <DataGridColumn TItem="Produit" For="@(p => p.Stock)" Title="Stock">
                        <EditTemplate>
                            <input type="number" class="form-control form-control-sm"
                                   value="@context.Stock"
                                   @onchange="@(e => context.Stock = int.TryParse(e.Value?.ToString(), out var v) ? v : context.Stock)" />
                        </EditTemplate>
                    </DataGridColumn>
                    <DataGridColumn TItem="Produit" For="@(p => p.Actif)" Title="Active">
                        <Template>
                            @if (context.Actif)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </Template>
                        <EditTemplate>
                            <input type="checkbox" class="form-check-input"
                                   checked="@context.Actif"
                                   @onchange="@(e => context.Actif = e.Value is true)" />
                        </EditTemplate>
                    </DataGridColumn>
                </ChildContent>
            </SuperDataGrid>
        </div>
    </div>

    <div class="col-md-6">
        <h4 class="mt-3">Horizontal (classic)</h4>
        <p class="text-muted">Same dataset, default orientation.</p>
        <div style="height: 500px;">
            <SuperDataGrid TItem="Produit"
                           ItemsProvider="LoadProduitsAsync"
                           GridOrientation="SuperDataGridOrientation.Horizontal"
                           Height="100%"
                           RowHeight="32"
                           AllowColumnReorder="false"
                           AllowColumnResize="false"
                           AllowFiltering="false"
                           DisplayColumnVisibilityToggle="false"
                           TableCssClass="table-striped table-hover table-bordered">
                <ChildContent>
                    <DataGridColumn TItem="Produit" For="@(p => p.Reference)" Title="Reference" Width="120px" />
                    <DataGridColumn TItem="Produit" For="@(p => p.Nom)" Title="Name" Width="180px" />
                    <DataGridColumn TItem="Produit" For="@(p => p.Categorie)" Title="Category" Width="140px" />
                    <DataGridColumn TItem="Produit" For="@(p => p.PrixUnitaire)" Title="Unit Price" Width="130px" FormatString="{0:C}" TextAlign="SuperTextAlignment.Right" />
                    <DataGridColumn TItem="Produit" For="@(p => p.Stock)" Title="Stock" Width="90px" TextAlign="SuperTextAlignment.Center" />
                    <DataGridColumn TItem="Produit" For="@(p => p.Actif)" Title="Active" Width="90px" TextAlign="SuperTextAlignment.Center">
                        <Template>
                            @if (context.Actif)
                            {
                                <span class="badge text-bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">No</span>
                            }
                        </Template>
                    </DataGridColumn>
                </ChildContent>
            </SuperDataGrid>
        </div>
    </div>
</div>

@code {
    private SuperDataGrid<Produit>? _gridVertical;

    private readonly List<Produit> _produits =
    [
        new("REF-001", "Mechanical keyboard, Mechanical keyboard, Mechanical keyboard, Mechanical keyboard ",     "Peripherals",  89.99m,   42,  true),
        new("REF-002", "Ergonomic mouse",        "Peripherals",  59.90m,   128, true),
        new("REF-003", "27\" 4K Monitor",         "Monitors",      449.00m,  15,  true),
        new("REF-004", "HDMI 2.1 Cable",          "Accessories",    12.50m,   340, true),
        new("REF-005", "USB-C Hub",               "Accessories",    34.99m,   87,  true),
        new("REF-006", "Wireless Headset",        "Audio",          129.00m,  63,  true),
        new("REF-007", "1080p Webcam",            "Video",          49.90m,   0,   false),
        new("REF-008", "1 TB SSD",                "Storage",       79.90m,   210, true),
        new("REF-009", "64 GB USB Drive",         "Storage",       9.99m,    520, true),
        new("REF-010", "XL Mouse Pad",            "Accessories",    19.90m,   175, true),
        new("REF-011", "Docking Station",         "Accessories",    189.00m,  22,  true),
        new("REF-012", "Monitor Arm",             "Furniture",       69.90m,   48,  false),
        new("REF-013", "Wrist Rest",              "Accessories",    14.90m,   95,  true),
        new("REF-014", "LED Desk Lamp",           "Furniture",       39.90m,   67,  true),
        new("REF-015", "USB Microphone",          "Audio",          24.90m,   0,   false),
        new("REF-016", "DisplayPort Adapter",     "Accessories",    15.00m,   290, true),
        new("REF-017", "Laptop Cooling Fan",      "Accessories",    29.90m,   38,  true),
        new("REF-018", "Power Bank",              "Energy",        45.00m,   112, true),
        new("REF-019", "65W Fast Charger",        "Energy",        35.00m,   204, true),
        new("REF-020", "15\" Laptop Sleeve",       "Protection",     22.90m,   156, true),
    ];

    private ValueTask<GridItemsProviderResult<Produit>> LoadProduitsAsync(GridItemsProviderRequest<Produit> request)
    {
        var query = _produits.AsEnumerable();

        query = (request.SortColumn, request.SortDirection) switch
        {
            (nameof(Produit.Reference),    SortDirection.Ascending)  => query.OrderBy(p => p.Reference),
            (nameof(Produit.Reference),    SortDirection.Descending) => query.OrderByDescending(p => p.Reference),
            (nameof(Produit.Nom),          SortDirection.Ascending)  => query.OrderBy(p => p.Nom),
            (nameof(Produit.Nom),          SortDirection.Descending) => query.OrderByDescending(p => p.Nom),
            (nameof(Produit.Categorie),    SortDirection.Ascending)  => query.OrderBy(p => p.Categorie),
            (nameof(Produit.Categorie),    SortDirection.Descending) => query.OrderByDescending(p => p.Categorie),
            (nameof(Produit.PrixUnitaire), SortDirection.Ascending)  => query.OrderBy(p => p.PrixUnitaire),
            (nameof(Produit.PrixUnitaire), SortDirection.Descending) => query.OrderByDescending(p => p.PrixUnitaire),
            (nameof(Produit.Stock),        SortDirection.Ascending)  => query.OrderBy(p => p.Stock),
            (nameof(Produit.Stock),        SortDirection.Descending) => query.OrderByDescending(p => p.Stock),
            _                                                        => query
        };

        var totalCount = query.Count();
        var page = query
            .Skip(request.StartIndex)
            .Take(request.Count ?? totalCount)
            .ToList();

        return ValueTask.FromResult(new GridItemsProviderResult<Produit>(page, totalCount));
    }

    private sealed class Produit(string reference, string nom, string categorie, decimal prixUnitaire, int stock, bool actif)
    {
        public string Reference { get; set; } = reference;
        public string Nom { get; set; } = nom;
        public string Categorie { get; set; } = categorie;
        public decimal PrixUnitaire { get; set; } = prixUnitaire;
        public int Stock { get; set; } = stock;
        public bool Actif { get; set; } = actif;
    }
}


