@page "/super-html-editor-demo"
@using SuperBlazorComponents.Components.SuperHtmlEditor

<PageTitle>SuperHtmlEditor Demo</PageTitle>

<h1>SuperHtmlEditor</h1>

<p class="text-muted">
    Éditeur HTML WYSIWYG avec barre d'outils complète (police, taille, gras, couleurs, listes, alignement)
    et basculement vers l'édition HTML source via <strong>Monaco Editor</strong> chargé à la volée.
</p>

@* ── Basique ────────────────────────────────────────────────────────── *@

<h2 class="mt-4">Basique</h2>

<DemoExample Title="Utilisation minimale"
             Description="Lier la valeur au composant. Le composant retourne du HTML."
             Code="@BasicHtmlEditorCode"
             CodeHeight="520">
    <SuperHtmlEditor @bind-Value="_basicHtml" />

    <div class="mt-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showBasicSource = !_showBasicSource">
            @(_showBasicSource ? "Masquer" : "Afficher") le HTML produit
        </button>
    </div>

    @if (_showBasicSource)
    {
        <pre class="bg-body-secondary border rounded p-3 mt-2"
             style="white-space:pre-wrap;word-break:break-all;font-size:12px;">@_basicHtml</pre>
    }
</DemoExample>

@* ── Avec label ─────────────────────────────────────────────────────── *@

<h2 class="mt-4">Avec label</h2>

<DemoExample Title="Paramètre Label"
             Description="Ajout d'un libelle au-dessus de l'editeur."
             Code="@LabelHtmlEditorCode">
    <SuperHtmlEditor Label="Corps du message" @bind-Value="_labelHtml" MinHeight="180" />
</DemoExample>

@* ── Contenu initial ─────────────────────────────────────────────────── *@

<h2 class="mt-4">Contenu initial</h2>

<DemoExample Title="Valeur pré-remplie"
             Description="Fournir du HTML initial via une valeur liee."
             Code="@PrefilledHtmlEditorCode"
             CodeHeight="420">
    <SuperHtmlEditor Label="Description" @bind-Value="_prefilledHtml" MinHeight="160" />
</DemoExample>

@* ── Taille personnalisée ────────────────────────────────────────────── *@

<h2 class="mt-4">Taille personnalisée</h2>

<DemoExample Title="Taille personnalisée"
             Description="MinHeight, MaxHeight et MonacoHeight controlent les hauteurs."
             Code="@SizedHtmlEditorCode">
    <SuperHtmlEditor Label="Note compacte" @bind-Value="_compactHtml" MinHeight="80" MaxHeight="200"
                     MonacoHeight="250" />
</DemoExample>

@* ── Désactivé ───────────────────────────────────────────────────────── *@

<h2 class="mt-4">Désactivé</h2>

<DemoExample Title="Paramètre Disabled"
             Description="Affichage du contenu HTML en lecture seule."
             Code="@DisabledHtmlEditorCode">
    <SuperHtmlEditor Label="Lecture seule (désactivé)"
                     Value="<p>Ce contenu <strong>ne peut pas</strong> être modifié.</p>" Disabled="true" />
</DemoExample>

@* ── Rendu HTML ──────────────────────────────────────────────────────── *@

<h2 class="mt-4">Aperçu du rendu</h2>

<DemoExample Title="Éditeur + aperçu côte à côte"
             Description="Le HTML produit peut etre affiche avec MarkupString."
             Code="@PreviewHtmlEditorCode"
             CodeHeight="520">
    <div class="row g-3">
        <div class="col-md-6">
            <SuperHtmlEditor Label="Éditeur" @bind-Value="_previewHtml" MinHeight="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Rendu</label>
            <div class="border rounded p-3 bg-body-secondary" style="min-height:200px;">
                @((MarkupString)(_previewHtml ?? ""))
            </div>
        </div>
    </div>
</DemoExample>

@code {
    private string? _basicHtml;
    private bool _showBasicSource;

    private string? _labelHtml;
    private string? _compactHtml;

    private string? _prefilledHtml = "<p>Bienvenue dans <strong>SuperHtmlEditor</strong> !</p>"
        + "<p>Essayez la mise en forme : <em>italique</em>, <u>souligné</u>, "
        + "<span style=\"color:#e03\">couleur</span>.</p>";

    private string? _previewHtml = "<h3>Titre</h3><p>Saisissez du texte ici pour voir le rendu en direct.</p>";

    private const string BasicHtmlEditorCode = """
    <SuperHtmlEditor @bind-Value="_basicHtml" />

    @code {
        private string? _basicHtml;
    }
    """;

    private const string LabelHtmlEditorCode = """
    <SuperHtmlEditor Label="Corps du message" @bind-Value="_labelHtml" MinHeight="180" />
    """;

    private const string PrefilledHtmlEditorCode = """
    <SuperHtmlEditor Label="Description" @bind-Value="_prefilledHtml" MinHeight="160" />

    @code {
        private string? _prefilledHtml = "<p>Bienvenue dans <strong>SuperHtmlEditor</strong> !</p>";
    }
    """;

    private const string SizedHtmlEditorCode = """
    <SuperHtmlEditor Label="Note compacte"
                     @bind-Value="_compactHtml"
                     MinHeight="80"
                     MaxHeight="200"
                     MonacoHeight="250" />
    """;

    private const string DisabledHtmlEditorCode = """
    <SuperHtmlEditor Label="Lecture seule"
                     Value="<p>Ce contenu <strong>ne peut pas</strong> être modifié.</p>"
                     Disabled="true" />
    """;

    private const string PreviewHtmlEditorCode = """
    <div class="row g-3">
        <div class="col-md-6">
            <SuperHtmlEditor Label="Éditeur" @bind-Value="_previewHtml" MinHeight="200" />
        </div>
        <div class="col-md-6">
            @((MarkupString)(_previewHtml ?? ""))
        </div>
    </div>
    """;
}
