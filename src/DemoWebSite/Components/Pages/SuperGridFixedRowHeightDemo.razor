@page "/supergrid-fixed-row-height-demo"
@using SuperBlazorComponents.Components.SuperDataGrid

<PageTitle>SuperGrid - Fixed Row Height</PageTitle>

<h1>SuperGrid - Fixed Row Height</h1>
<p class="text-muted">
    Rows are fixed at <code>44px</code>. Cells with taller content keep the row height stable and scroll vertically inside the cell.
</p>

<div style="height: 520px;">
    <SuperDataGrid TItem="InventoryAlert"
                   ItemsProvider="LoadAlertsAsync"
                   RowHeight="44"
                   FixedRowHeight="true"
                   DisplaySelectionColumn="false"
                   DisplayRefreshButton="true"
                   FreezeLeftColumns="1">
        <ChildContent>
            <DataGridColumn For="@(alert => alert.Reference)" Title="Reference" Width="130px" AlwaysVisible="true" />
            <DataGridColumn For="@(alert => alert.Designation)" Title="Designation" Width="220px">
                <Template>
                    <div class="fw-semibold">@context.Designation</div>
                    <div class="text-muted small">@context.Category</div>
                </Template>
            </DataGridColumn>
            <DataGridColumn For="@(alert => alert.SupplierNotes)" Title="Supplier notes" Width="260px">
                <Template>
                    @foreach (var line in context.SupplierNotes)
                    {
                        <div>@line</div>
                    }
                </Template>
            </DataGridColumn>
            <DataGridColumn For="@(alert => alert.Tags)" Title="Tags" Width="190px">
                <Template>
                    @foreach (var tag in context.Tags)
                    {
                        <span class="badge text-bg-secondary me-1 mb-1">@tag</span>
                    }
                </Template>
            </DataGridColumn>
            <DataGridColumn For="@(alert => alert.Comment)" Title="Long comment" Width="360px">
                <Template>
                    <div>@context.Comment</div>
                </Template>
            </DataGridColumn>
            <DataGridColumn For="@(alert => alert.Stock)" Title="Stock" Width="90px" TextAlign="SuperTextAlignment.Right" />
            <DataGridColumn For="@(alert => alert.Risk)" Title="Risk" Width="90px" TextAlign="SuperTextAlignment.Center">
                <Template>
                    <span class="badge text-bg-danger">@context.Risk %</span>
                </Template>
            </DataGridColumn>
        </ChildContent>
    </SuperDataGrid>
</div>

