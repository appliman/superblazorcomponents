    private static ValueTask<GridItemsProviderResult<InventoryAlert>> LoadAlertsAsync(GridItemsProviderRequest<InventoryAlert> request)
    {
        var query = _alerts.AsEnumerable();

        query = (request.SortColumn, request.SortDirection) switch
        {
            (nameof(InventoryAlert.Reference), SortDirection.Ascending) => query.OrderBy(alert => alert.Reference),
            (nameof(InventoryAlert.Reference), SortDirection.Descending) => query.OrderByDescending(alert => alert.Reference),
            (nameof(InventoryAlert.Stock), SortDirection.Ascending) => query.OrderBy(alert => alert.Stock),
            (nameof(InventoryAlert.Stock), SortDirection.Descending) => query.OrderByDescending(alert => alert.Stock),
            (nameof(InventoryAlert.Risk), SortDirection.Ascending) => query.OrderBy(alert => alert.Risk),
            (nameof(InventoryAlert.Risk), SortDirection.Descending) => query.OrderByDescending(alert => alert.Risk),
            _ => query
        };

        var totalCount = query.Count();
        var count = request.Count is > 0 ? request.Count.Value : totalCount;
        var page = query
            .Skip(request.StartIndex)
            .Take(count)
            .ToList();

        return ValueTask.FromResult(new GridItemsProviderResult<InventoryAlert>(page, totalCount));
    }

    private sealed record InventoryAlert(
        string Reference,
        string Designation,
        string Category,
        IReadOnlyList<string> SupplierNotes,
        IReadOnlyList<string> Tags,
        string Comment,
        int Stock,
        int Risk);
}
