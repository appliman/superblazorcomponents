@page "/super-markdown-editor-demo"
@using SuperBlazorComponents.Components.SuperMarkdownEditor

<PageTitle>SuperMarkdownEditor Demo</PageTitle>

<h1>SuperMarkdownEditor</h1>

<p class="text-muted">
    Simple Markdown editor with a rendered view by default and a toggle to Markdown source.
</p>

<DemoExample Title="Minimal usage"
             Description="Rendered mode by default with a toolbar toggle to Markdown source."
             Code="@MinimalMarkdownCode">
    <SuperMarkdownEditor @bind-Value="_basicMarkdown" />
</DemoExample>

<DemoExample Title="Integrated toolbar"
             Description="Toolbar with help and Markdown / rendered toggle."
             Code="@IntegratedToolbarCode">
    <SuperMarkdownEditor Label="Notes" @bind-Value="_toolbarMarkdown" MinHeight="180" />
</DemoExample>

<DemoExample Title="External toolbar"
             Description="Toolbar rendered outside the editor and bound to the same view mode."
             Code="@ExternalToolbarCode"
             CodeHeight="420">
    <SuperMarkdownEditorToolbar @bind-RenderedView="_integratedRenderedView" />
    <SuperMarkdownEditor EditorId="markdown-integrated" @bind-Value="_integratedMarkdown"
                         @bind-RenderedView="_integratedRenderedView" ShowToolbar="false" MinHeight="200" />
</DemoExample>

<DemoExample Title="Disabled"
             Description="Read-only Markdown content."
             Code="@DisabledMarkdownCode">
    <SuperMarkdownEditor Label="Read-only" Value="# Locked document\n\nThis content cannot be edited."
                         Disabled="true" />
</DemoExample>

<DemoExample Title="Initial content example"
             Description="Editor initialized with Markdown content."
             Code="@InitialMarkdownCode">
    <SuperMarkdownEditor Label="Draft" @bind-Value="_prefilledMarkdown" MinHeight="220" />
</DemoExample>

@code {
    private const string MinimalMarkdownCode = """
    <SuperMarkdownEditor @bind-Value="_basicMarkdown" />

    @code {
        private string? _basicMarkdown = "# Hello\n\nStart writing in **Markdown** here.";
    }
    """;

    private const string IntegratedToolbarCode = """
    <SuperMarkdownEditor Label="Notes" @bind-Value="_toolbarMarkdown" MinHeight="180" />

    @code {
        private string? _toolbarMarkdown = "## Notes\n\n- List\n- Rendered view by default\n";
    }
    """;

    private const string ExternalToolbarCode = """
    <SuperMarkdownEditorToolbar @bind-RenderedView="_renderedView" />
    <SuperMarkdownEditor EditorId="markdown-integrated"
                         @bind-Value="_markdown"
                         @bind-RenderedView="_renderedView"
                         ShowToolbar="false"
                         MinHeight="200" />

    @code {
        private string? _markdown = "### External toolbar";
        private bool _renderedView = true;
    }
    """;

    private const string DisabledMarkdownCode = """
    <SuperMarkdownEditor Label="Read-only"
                         Value="# Locked document\n\nThis content cannot be edited."
                         Disabled="true" />
    """;

    private const string InitialMarkdownCode = """
    <SuperMarkdownEditor Label="Draft" @bind-Value="_prefilledMarkdown" MinHeight="220" />

    @code {
        private string? _prefilledMarkdown = "# Title\n\nA paragraph with **bold** and *italic* text.";
    }
    """;

    private string? _basicMarkdown = "# Hello\n\nStart writing in **Markdown** here.";

    private string? _toolbarMarkdown = "## Notes\n\n- List\n- Rendered view by default\n";

    private string? _integratedMarkdown = "### External toolbar\n\nUse the toolbar above to switch between rendered and Markdown modes.";
    private bool _integratedRenderedView = true;

    private string? _prefilledMarkdown = "# Title\n\nA paragraph with **bold**, *italic*, and <u>underlined</u> text.";
}
