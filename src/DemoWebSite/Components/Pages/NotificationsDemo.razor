@page "/notifications-demo"

@using SuperBlazorComponents.Components.Notifications
@using SuperBlazorComponents.Services
@using SuperBlazorComponents.Components.Buttons

@inject SuperNotificationService NotificationService

<PageTitle>Notifications Demo</PageTitle>

<h1>Notifications</h1>

<p class="text-muted">
    Démo des toasts via <code>NotificationService.Notify</code>.
</p>

<div class="card mt-3">
    <div class="card-header">Déclenchement</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <SuperButton Text="Info" Style="SuperButtonStyle.Info" Icon="fa-solid fa-circle-info" Click="@NotifyInfoAsync" />
            <SuperButton Text="Success" Style="SuperButtonStyle.Success" Icon="fa-solid fa-circle-check" Click="@NotifySuccessAsync" />
            <SuperButton Text="Warning" Style="SuperButtonStyle.Warning" Icon="fa-solid fa-triangle-exclamation" Click="@NotifyWarningAsync" />
            <SuperButton Text="Error" Style="SuperButtonStyle.Danger" Icon="fa-solid fa-circle-xmark" Click="@NotifyDangerAsync" />
            <SuperButton Text="Click action" Style="SuperButtonStyle.Primary" Icon="fa-solid fa-bolt" Click="@NotifyClickableAsync" />
        </div>
    </div>
</div>

@code
{
    private Task NotifyInfoAsync()
    {
        return NotificationService.Notify(NotificationSeverity.Info, "Info", "Notification d'information", 3000);
    }

    private Task NotifySuccessAsync()
    {
        return NotificationService.Notify(NotificationSeverity.Success, "Succès", "Opération réussie", 3000);
    }

    private Task NotifyWarningAsync()
    {
        return NotificationService.Notify(NotificationSeverity.Warning, "Avertissement", "Attention à ce point", 5000);
    }

    private Task NotifyDangerAsync()
    {
        return NotificationService.Notify(NotificationSeverity.Error, "Erreur", "Quelque chose s'est mal passé", 0);
    }

    private Task NotifyClickableAsync()
    {
        return NotificationService.Notify(
            NotificationSeverity.Info,
            "Action",
            "Cliquez pour fermer.",
            duration: 0,
            click: _ => { },
            closeOnClick: true);
    }
}
