@page "/super-date-range-dialog-demo"

@using System.Globalization
@using SuperBlazorComponents.Components
@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDateRange
@using SuperBlazorComponents.Services

@inject SuperDialogService DialogService

<PageTitle>SuperDateRangeDialog</PageTitle>

<h1>SuperDateRangeDialog</h1>

<p class="text-muted">
    Démonstration du sélecteur de période affiché dans une modale dynamique via <code>DialogService</code>.
</p>

<div class="card mt-3">
    <div class="card-header">
        Ouvrir la modale
    </div>
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex flex-wrap gap-2">
            <SuperButton Text="Choisir une période" Style="SuperButtonStyle.Primary" Click="OpenDialogAsync" />
            <SuperButton Text="Autoriser les dates futures" Style="SuperButtonStyle.Secondary" Click="OpenDialogWithFutureDatesAsync" />
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Période</div>
                    <div class="fw-semibold">@GetSummaryText(_selectedRange)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Date de début</div>
                    <div class="fw-semibold">@GetDateText(_selectedRange?.StartDate)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Date de fin</div>
                    <div class="fw-semibold">@GetDateText(_selectedRange?.EndDate)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Preset</div>
                    <div class="fw-semibold">@GetPresetText(_selectedRange?.Preset)</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("fr-FR");

    private SuperDateRangeSelection? _selectedRange = new(null, null, SuperDateRangePreset.AllTime);

    private async Task OpenDialogAsync()
    {
        _selectedRange = await DialogService.OpenDateRangeDialogAsync(
            "Sélectionner une période",
            _selectedRange,
            displayWeekNumbers: true,
            disableFutureDates: true);
    }

    private async Task OpenDialogWithFutureDatesAsync()
    {
        _selectedRange = await DialogService.OpenDateRangeDialogAsync(
            "Sélectionner une période",
            _selectedRange,
            displayWeekNumbers: true,
            disableFutureDates: false);
    }

    private static string GetDateText(DateTime? date)
    {
        return date?.ToString("d MMM yyyy", FrCulture) ?? "Non définie";
    }

    private static string GetPresetText(SuperDateRangePreset? preset)
    {
        if (!preset.HasValue)
        {
            return "Aucun";
        }

        return preset.Value switch
        {
            SuperDateRangePreset.Today => "Aujourd'hui",
            SuperDateRangePreset.Yesterday => "Hier",
            SuperDateRangePreset.ThisWeek => "Cette semaine (lun. - aujourd'hui)",
            SuperDateRangePreset.LastWeek => "La semaine dernière (lun. - dim.)",
            SuperDateRangePreset.Last7Days => "7 derniers jours",
            SuperDateRangePreset.Last14Days => "14 derniers jours",
            SuperDateRangePreset.Last30Days => "30 derniers jours",
            SuperDateRangePreset.Last90Days => "90 derniers jours",
            SuperDateRangePreset.ThisMonth => "Ce mois-ci",
            SuperDateRangePreset.LastMonth => "Le mois dernier",
            SuperDateRangePreset.ThisQuarter => "Ce trimestre",
            SuperDateRangePreset.LastQuarter => "Le trimestre dernier",
            SuperDateRangePreset.ThisYear => "Cette année",
            SuperDateRangePreset.LastYear => "L'année dernière",
            SuperDateRangePreset.AllTime => "Toute la période",
            _ => "Personnalisée"
        };
    }

    private static string GetSummaryText(SuperDateRangeSelection? range)
    {
        if (range is null)
        {
            return "Annulé";
        }

        if (!string.IsNullOrWhiteSpace(range.PeriodName))
        {
            return range.PeriodName;
        }

        if (range.Preset != SuperDateRangePreset.Custom)
        {
            return GetPresetText(range.Preset);
        }

        if (range.StartDate is null && range.EndDate is null)
        {
            return "Toute la période";
        }

        if (range.StartDate is not null && range.EndDate is not null)
        {
            if (range.StartDate == range.EndDate)
            {
                return range.StartDate.Value.ToString("d MMM yyyy", FrCulture);
            }

            return $"{range.StartDate.Value.ToString("d MMM yyyy", FrCulture)} - {range.EndDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        if (range.StartDate is not null)
        {
            return $"Depuis le {range.StartDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        return $"Jusqu'au {range.EndDate!.Value.ToString("d MMM yyyy", FrCulture)}";
    }
}
