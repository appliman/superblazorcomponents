@page "/super-date-range-dialog-demo"

@using System.Globalization
@using SuperBlazorComponents.Components
@using SuperBlazorComponents.Components.Buttons
@using SuperBlazorComponents.Components.SuperDateRange
@using SuperBlazorComponents.Services

@inject SuperDialogService DialogService

<PageTitle>SuperDateRangeDialog</PageTitle>

<h1>SuperDateRangeDialog</h1>

<p class="text-muted">
    Demonstration of the period selector displayed in a dynamic modal via <code>DialogService</code>.
</p>

<div class="card mt-3">
    <div class="card-header">
        Open Modal
    </div>
    <div class="card-body d-flex flex-column gap-3">
        <div class="d-flex flex-wrap gap-2">
            <SuperButton Text="Choose a period" Style="SuperButtonStyle.Primary" Click="OpenDialogAsync" />
            <SuperButton Text="Allow future dates" Style="SuperButtonStyle.Secondary" Click="OpenDialogWithFutureDatesAsync" />
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Period</div>
                    <div class="fw-semibold">@GetSummaryText(_selectedRange)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Start Date</div>
                    <div class="fw-semibold">@GetDateText(_selectedRange?.StartDate)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">End Date</div>
                    <div class="fw-semibold">@GetDateText(_selectedRange?.EndDate)</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="border rounded p-3 h-100 bg-body-tertiary">
                    <div class="small text-body-secondary">Preset</div>
                    <div class="fw-semibold">@GetPresetText(_selectedRange?.Preset)</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly CultureInfo FrCulture = CultureInfo.GetCultureInfo("en-US");

    private SuperDateRangeSelection? _selectedRange = new(null, null, SuperDateRangePreset.AllTime);

    private async Task OpenDialogAsync()
    {
        _selectedRange = await DialogService.OpenDateRangeDialogAsync(
            "Select a Period",
            _selectedRange,
            displayWeekNumbers: true,
            disableFutureDates: true);
    }

    private async Task OpenDialogWithFutureDatesAsync()
    {
        _selectedRange = await DialogService.OpenDateRangeDialogAsync(
            "Select a Period",
            _selectedRange,
            displayWeekNumbers: true,
            disableFutureDates: false);
    }

    private static string GetDateText(DateTime? date)
    {
        return date?.ToString("d MMM yyyy", FrCulture) ?? "Not set";
    }

    private static string GetPresetText(SuperDateRangePreset? preset)
    {
        if (!preset.HasValue)
        {
            return "None";
        }

        return preset.Value switch
        {
            SuperDateRangePreset.Today => "Today",
            SuperDateRangePreset.Yesterday => "Yesterday",
            SuperDateRangePreset.ThisWeek => "This Week (Mon. - today)",
            SuperDateRangePreset.LastWeek => "Last Week (Mon. - Sun.)",
            SuperDateRangePreset.Last7Days => "Last 7 Days",
            SuperDateRangePreset.Last14Days => "Last 14 Days",
            SuperDateRangePreset.Last30Days => "Last 30 Days",
            SuperDateRangePreset.Last90Days => "Last 90 Days",
            SuperDateRangePreset.ThisMonth => "This Month",
            SuperDateRangePreset.LastMonth => "Last Month",
            SuperDateRangePreset.ThisQuarter => "This Quarter",
            SuperDateRangePreset.LastQuarter => "Last Quarter",
            SuperDateRangePreset.ThisYear => "This Year",
            SuperDateRangePreset.LastYear => "Last Year",
            SuperDateRangePreset.AllTime => "All Time",
            _ => "Custom"
        };
    }

    private static string GetSummaryText(SuperDateRangeSelection? range)
    {
        if (range is null)
        {
            return "Cancelled";
        }

        if (!string.IsNullOrWhiteSpace(range.PeriodName))
        {
            return range.PeriodName;
        }

        if (range.Preset != SuperDateRangePreset.Custom)
        {
            return GetPresetText(range.Preset);
        }

        if (range.StartDate is null && range.EndDate is null)
        {
            return "All Time";
        }

        if (range.StartDate is not null && range.EndDate is not null)
        {
            if (range.StartDate == range.EndDate)
            {
                return range.StartDate.Value.ToString("d MMM yyyy", FrCulture);
            }

            return $"{range.StartDate.Value.ToString("d MMM yyyy", FrCulture)} - {range.EndDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        if (range.StartDate is not null)
        {
            return $"Since {range.StartDate.Value.ToString("d MMM yyyy", FrCulture)}";
        }

        return $"Until {range.EndDate!.Value.ToString("d MMM yyyy", FrCulture)}";
    }
}
