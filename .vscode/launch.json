{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DemoWebSite",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build DemoWebSite",
            "program": "${workspaceFolder}/src/DemoWebSite/bin/Debug/net10.0/DemoWebSite.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/DemoWebSite",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/todo-supergrid-demo"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5062"
            }
        }
    ]
}
